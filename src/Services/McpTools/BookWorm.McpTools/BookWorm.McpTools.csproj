<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <NoWarn>$(NoWarn);MCPEXP005</NoWarn>
    <SuppressCheckGrpcNetClientFactoryVersion>true</SuppressCheckGrpcNetClientFactoryVersion>
  </PropertyGroup>
  <ItemGroup Label="OCI Labels">
    <ContainerLabel
      Include="org.opencontainers.image.description"
      Value="BookWorm MCP Tools Image"
    />
    <ContainerLabel Include="org.opencontainers.image.authors" Value="Nhan Nguyen" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.Tools" PrivateAssets="All" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="ModelContextProtocol.Extensions.Skills" />
    <PackageReference Include="Vogen" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Aspire\BookWorm.ServiceDefaults\BookWorm.ServiceDefaults.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile
      Include="..\..\Catalog\BookWorm.Catalog\Domain\Values\DecimalValue.cs"
      Link="Domain\DecimalValue.cs"
    />
  </ItemGroup>
  <ItemGroup>
    <Protobuf
      Include="..\..\Catalog\BookWorm.Catalog\Grpc\Protos\book\v1\book.proto"
      Link="Grpc\Protos\book\v1\book.proto"
      GrpcServices="Client"
    />
  </ItemGroup>
  <ItemGroup Label="Agent Skills">
    <Content Include="Skills\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup Label="Governance Policies">
    <Content Include="Policies\*.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
    <InternalsVisibleTo Include="$(AssemblyName).UnitTests" />
  </ItemGroup>
</Project>
