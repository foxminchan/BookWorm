<Project Sdk="Azure.Functions.Sdk">
  <PropertyGroup>
    <NoWarn>$(NoWarn);AZFW0108</NoWarn>
  </PropertyGroup>
  <ItemGroup Label="OCI Labels">
    <ContainerLabel
      Include="org.opencontainers.image.description"
      Value="BookWorm Finance Service Image"
    />
    <ContainerLabel Include="org.opencontainers.image.authors" Value="Nhan Nguyen" />
  </ItemGroup>
  <ItemGroup Label="Framework">
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.Functions.Worker" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.DurableTask" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.DurableTask.AzureManaged" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Kafka" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.OpenTelemetry" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
    <InternalsVisibleTo Include="$(AssemblyName).UnitTests" />
    <InternalsVisibleTo Include="$(AssemblyName).ContractTests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Aspire\BookWorm.ServiceDefaults\BookWorm.ServiceDefaults.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None
      Update="host.json"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
    />
    <None
      Update="local.settings.json"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="Never"
    />
  </ItemGroup>
</Project>
