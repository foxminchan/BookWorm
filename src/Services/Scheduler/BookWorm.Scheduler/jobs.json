{
  "ProcessingDirectives": {
    "OverwriteExistingData": true
  },
  "Schedule": {
    "Jobs": [
      {
        "Description": "Publishes an event to process pending catalog vector updates",
        "Durable": true,
        "Group": "Scheduler",
        "JobType": "BookWorm.Scheduler.Jobs.ProcessVectorBatchJob, BookWorm.Scheduler",
        "Name": "ProcessVectorBatchJob",
        "Recover": false
      },
      {
        "Description": "Emits a periodic scheduler heartbeat for observability",
        "Durable": true,
        "Group": "Scheduler",
        "JobType": "BookWorm.Scheduler.Jobs.HeartbeatJob, BookWorm.Scheduler",
        "Name": "HeartbeatJob",
        "Recover": false
      }
    ],
    "Triggers": [
      {
        "Cron": {
          "Expression": "0 0/5 * * * ?",
          "MisfireInstruction": "FireOnceNow",
          "TimeZone": "UTC"
        },
        "Description": "Fires every five minutes to refresh changed catalog vectors",
        "Group": "Scheduler",
        "JobGroup": "Scheduler",
        "JobName": "ProcessVectorBatchJob",
        "Name": "ProcessVectorBatchTrigger"
      },
      {
        "Cron": {
          "Expression": "0/30 * * * * ?",
          "MisfireInstruction": "FireOnceNow",
          "TimeZone": "UTC"
        },
        "Description": "Fires every 30 seconds to record scheduler activity",
        "Group": "Scheduler",
        "JobGroup": "Scheduler",
        "JobName": "HeartbeatJob",
        "Name": "HeartbeatTrigger"
      }
    ]
  }
}
