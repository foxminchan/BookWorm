<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <NoWarn>$(NoWarn);EXTEXP0001</NoWarn>
  </PropertyGroup>
  <ItemGroup Label="OCI Labels">
    <ContainerLabel
      Include="org.opencontainers.image.description"
      Value="BookWorm Scheduler Service Image"
    />
    <ContainerLabel Include="org.opencontainers.image.authors" Value="Nhan Nguyen" />
  </ItemGroup>
  <ItemGroup Label="Quartz">
    <PackageReference Include="Aspire.Azure.Npgsql" />
    <PackageReference Include="Quartz.Aspire" />
    <PackageReference Include="Quartz.Plugins" />
    <PackageReference Include="Quartz.Dashboard.Agent" />
  </ItemGroup>
  <ItemGroup Label="Quartz JSON Config">
    <None Update="jobs.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
    <InternalsVisibleTo Include="$(AssemblyName).UnitTests" />
    <InternalsVisibleTo Include="$(AssemblyName).ContractTests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Aspire\BookWorm.ServiceDefaults\BookWorm.ServiceDefaults.csproj" />
  </ItemGroup>
</Project>
