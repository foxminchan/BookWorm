{
  "name": "@bookworm/backoffice",
  "version": "1.0.0",
  "type": "module",
  "description": "Administration backoffice for BookWorm online bookstore",
  "author": "Nhan Nguyen <nguyenxuannhan407@gmail.com> (https://github.com/foxminchan)",
  "licenses": [
    {
      "type": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  ],
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foxminchan/BookWorm.git",
    "directory": "src/Clients/apps/backoffice"
  },
  "bugs": {
    "url": "https://github.com/foxminchan/BookWorm/issues"
  },
  "homepage": "https://foxminchan.github.io/BookWorm/",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "check-types": "bun ../../node_modules/@typescript/native/bin/tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "bddgen": "npx bddgen",
    "bddgen:watch": "npx bddgen --watch",
    "bddgen:export": "npx bddgen export",
    "test:e2e": "npx bddgen && npx playwright test",
    "test:e2e:headed": "npx bddgen && npx playwright test --headed",
    "test:e2e:ui": "npx bddgen && npx playwright test --ui",
    "test:e2e:ci": "npx bddgen && npx playwright test --workers=4",
    "playwright:install": "playwright install --with-deps chromium",
    "playwright:install:all": "playwright install --with-deps",
    "allure:generate": "allure generate --output allure-report allure-results",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-table": "^9.2.4",
    "@workspace/api-client": "workspace:*",
    "@workspace/api-hooks": "workspace:*",
    "@workspace/mocks": "workspace:*",
    "@workspace/otel": "workspace:*",
    "@workspace/types": "workspace:*",
    "@workspace/ui": "workspace:*",
    "@workspace/utils": "workspace:*",
    "@workspace/validations": "workspace:*",
    "better-auth": "^1.7.5",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "ts-pattern": "^5.9.0",
    "usehooks-ts": "3.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "allure": "^3.18.0",
    "allure-playwright": "^3.12.2",
    "allure-vitest": "^3.12.2",
    "eslint": "^10.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "happy-dom": "^20.14.5",
    "playwright-bdd": "^9.2.1",
    "typescript": "npm:typescript@^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
