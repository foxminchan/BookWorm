{
  "name": "@bookworm/storefront",
  "version": "1.0.0",
  "type": "module",
  "description": "Customer-facing storefront application for BookWorm",
  "author": "Nhan Nguyen <nguyenxuannhan407@gmail.com> (https://github.com/foxminchan)",
  "licenses": [
    {
      "type": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  ],
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foxminchan/BookWorm.git",
    "directory": "src/Clients/apps/storefront"
  },
  "bugs": {
    "url": "https://github.com/foxminchan/BookWorm/issues"
  },
  "homepage": "https://foxminchan.github.io/BookWorm/",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "check-types": "bun ../../node_modules/@typescript/native/bin/tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "bddgen": "npx bddgen",
    "bddgen:watch": "npx bddgen --watch",
    "bddgen:export": "npx bddgen export",
    "test:e2e": "npx bddgen && npx playwright test",
    "test:e2e:headed": "npx bddgen && npx playwright test --headed",
    "test:e2e:ui": "npx bddgen && npx playwright test --ui",
    "test:e2e:ci": "npx bddgen && npx playwright test --workers=4",
    "playwright:install": "playwright install --with-deps chromium",
    "playwright:install:all": "playwright install --with-deps",
    "allure:generate": "allure generate --clean --config ./allurerc.mjs --output allure-report allure-results",
    "allure:open": "allure open --config ./allurerc.mjs allure-report",
    "allure:serve": "allure serve --config ./allurerc.mjs allure-results"
  },
  "dependencies": {
    "@ag-ui/client": "^1.0.5",
    "@copilotkit/react-core": "2.0.0-rc.65",
    "@copilotkit/runtime": "2.0.0-rc.65",
    "@hookform/resolvers": "^7.0.7",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.108.0",
    "@workspace/api-client": "workspace:*",
    "@workspace/api-hooks": "workspace:*",
    "@workspace/mocks": "workspace:*",
    "@workspace/otel": "workspace:*",
    "@workspace/types": "workspace:*",
    "@workspace/ui": "workspace:*",
    "@workspace/utils": "workspace:*",
    "@workspace/validations": "workspace:*",
    "better-auth": "^1.7.26",
    "date-fns": "^4.4.0",
    "jotai": "^3.0.2",
    "jotai-tanstack-query": "^0.11.0",
    "lucide-react": "^1.76.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "ts-pattern": "^5.9.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "@vitest/ui": "^5.1.1",
    "@workspace/allure-config": "workspace:*",
    "@workspace/app-config": "workspace:*",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "allure": "^3.33.0",
    "allure-playwright": "^3.15.0",
    "allure-vitest": "^3.15.0",
    "eslint": "^10.15.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "fast-check": "^4.10.3",
    "happy-dom": "^21.0.4",
    "playwright-bdd": "^9.2.1",
    "typescript": "npm:typescript@^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
