{
  "name": "@bookworm/commerce",
  "version": "1.0.0",
  "type": "module",
  "description": "Authenticated customer basket, checkout, and account microfrontend for BookWorm",
  "author": "Nhan Nguyen <nguyenxuannhan407@gmail.com> (https://github.com/foxminchan)",
  "licenses": [
    {
      "type": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  ],
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foxminchan/BookWorm.git",
    "directory": "src/Clients/apps/commerce"
  },
  "bugs": {
    "url": "https://github.com/foxminchan/BookWorm/issues"
  },
  "homepage": "https://foxminchan.github.io/BookWorm/",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "check-types": "bun ../../node_modules/@typescript/native/bin/tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "allure:generate": "allure generate --clean --config ./allurerc.mjs --output allure-report allure-results",
    "allure:open": "allure open --config ./allurerc.mjs allure-report",
    "allure:serve": "allure serve --config ./allurerc.mjs allure-results"
  },
  "dependencies": {
    "@formisch/react": "^1.2.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.108.4",
    "@vercel/microfrontends": "^2.4.2",
    "@workspace/api-client": "workspace:*",
    "@workspace/api-hooks": "workspace:*",
    "@workspace/auth": "workspace:*",
    "@workspace/env": "workspace:*",
    "@workspace/mocks": "workspace:*",
    "@workspace/otel": "workspace:*",
    "@workspace/seo": "workspace:*",
    "@workspace/storefront-shell": "workspace:*",
    "@workspace/types": "workspace:*",
    "@workspace/ui": "workspace:*",
    "@workspace/utils": "workspace:*",
    "@workspace/validations": "workspace:*",
    "better-auth": "^1.7.28",
    "date-fns": "^4.4.0",
    "jotai": "^3.0.2",
    "jotai-tanstack-query": "^0.11.0",
    "lucide-react": "^1.81.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-pattern": "^5.9.2",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.2",
    "@vitest/ui": "^5.1.2",
    "@workspace/allure-config": "workspace:*",
    "@workspace/app-config": "workspace:*",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "allure": "^3.33.0",
    "allure-vitest": "^3.15.0",
    "eslint": "^10.15.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "happy-dom": "^21.0.4",
    "typescript": "npm:typescript@^6.0.3",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
