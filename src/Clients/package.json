{
  "name": "@bookworm/clients",
  "version": "1.0.0",
  "description": "Frontend clients for BookWorm application",
  "author": "Nhan Nguyen <nguyenxuannhan407@gmail.com> (https://github.com/foxminchan)",
  "licenses": [
    {
      "type": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  ],
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foxminchan/BookWorm.git",
    "directory": "src/Clients"
  },
  "bugs": {
    "url": "https://github.com/foxminchan/BookWorm/issues"
  },
  "homepage": "https://foxminchan.github.io/BookWorm/",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "e2e": "turbo run test:e2e",
    "allure:generate": "turbo run allure:generate",
    "allure:report": "allure generate --clean --config ./allurerc.mjs --output allure-report apps/backoffice/allure-results apps/storefront/allure-results",
    "boundaries": "turbo boundaries",
    "format": "prettier --write \"**/*.{ts,tsx,md,feature}\""
  },
  "lavamoat": {
    "allowScripts": {}
  },
  "devDependencies": {
    "@lavamoat/allow-scripts": "^5.1.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@workspace/allure-config": "workspace:*",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "allure": "^3.33.0",
    "prettier": "^3.10.1",
    "prettier-plugin-gherkin": "^4.0.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.13",
    "typescript": "npm:typescript@^6.0.3"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "hono": "^4.13.16",
    "ip-address": "^10.7.4",
    "postcss": "8.5.26"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
