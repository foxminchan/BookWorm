<Project>
  <PropertyGroup Label="Package Versions">
    <!-- Core Libraries -->
    <AspireVersion>13.6.1</AspireVersion>
    <AspireUnstableVersion>$(AspireVersion)-preview.1.26506.6</AspireUnstableVersion>
    <DotnetPackagesVersion>10.0.13</DotnetPackagesVersion>
    <GrpcVersion>2.84.0</GrpcVersion>
    <!-- Integration Libraries -->
    <WolverineVersion>6.51.1</WolverineVersion>
    <QuartzVersion>4.5.1</QuartzVersion>
    <FusionCacheVersion>2.9.0</FusionCacheVersion>
    <!-- Microsoft Packages -->
    <MsExtVersion>10.11.0</MsExtVersion>
    <MsTestVersion>2.5.1</MsTestVersion>
    <ToolKitVersion>13.6.0</ToolKitVersion>
    <!-- Agent Framework Packages -->
    <AgentFrameworkVersion>1.25.0</AgentFrameworkVersion>
    <AgentFrameworkUnstableVersion>$(AgentFrameworkVersion)-preview.261014.1</AgentFrameworkUnstableVersion>
    <AgentFrameworkAlphaVersion>$(AgentFrameworkVersion)-alpha.261014.1</AgentFrameworkAlphaVersion>
    <!-- Miscellaneous Packages -->
    <HealthChecksVersion>9.0.0</HealthChecksVersion>
  </PropertyGroup>
</Project>
