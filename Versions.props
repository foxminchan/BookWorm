<Project>
  <PropertyGroup Label="Package Versions">
    <!-- Core Libraries -->
    <AspireVersion>13.5.0</AspireVersion>
    <AspireUnstableVersion>$(AspireVersion)-preview.1.26417.10</AspireUnstableVersion>
    <DotnetPackagesVersion>10.0.11</DotnetPackagesVersion>
    <GrpcVersion>2.83.0</GrpcVersion>
    <!-- Integration Libraries -->
    <WolverineVersion>6.29.0</WolverineVersion>
    <TUnitVersion>1.65.31</TUnitVersion>
    <QuartzVersion>3.19.1</QuartzVersion>
    <FusionCacheVersion>2.6.0</FusionCacheVersion>
    <!-- Microsoft Packages -->
    <MsExtVersion>10.9.0</MsExtVersion>
    <MsTestVersion>2.3.3</MsTestVersion>
    <ToolKitVersion>13.4.0</ToolKitVersion>
    <AgentFrameworkVersion>1.18.0</AgentFrameworkVersion>
    <AgentFrameworkUnstableVersion>$(AgentFrameworkVersion)-preview.260818.1</AgentFrameworkUnstableVersion>
    <!-- Observability & Health -->
    <HealthChecksVersion>9.0.0</HealthChecksVersion>
  </PropertyGroup>
</Project>
