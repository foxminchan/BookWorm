<Project>
  <PropertyGroup Label="Package Versions">
    <!-- Core Libraries -->
    <AspireVersion>13.4.6</AspireVersion>
    <AspireUnstableVersion>$(AspireVersion)-preview.1.26319.6</AspireUnstableVersion>
    <DotnetPackagesVersion>10.0.10</DotnetPackagesVersion>
    <GrpcVersion>2.80.0</GrpcVersion>
    <!-- Integration Libraries -->
    <WolverineVersion>6.17.1</WolverineVersion>
    <TUnitVersion>1.58.0</TUnitVersion>
    <QuartzVersion>3.18.2</QuartzVersion>
    <FusionCacheVersion>2.6.0</FusionCacheVersion>
    <!-- Microsoft Packages -->
    <MsExtVersion>10.8.0</MsExtVersion>
    <MsTestVersion>2.3.1</MsTestVersion>
    <ToolKitVersion>13.4.0</ToolKitVersion>
    <AgentFrameworkVersion>1.13.0</AgentFrameworkVersion>
    <AgentFrameworkUnstableVersion>$(AgentFrameworkVersion)-preview.260703.1</AgentFrameworkUnstableVersion>
    <!-- Observability & Health -->
    <HealthChecksVersion>9.0.0</HealthChecksVersion>
  </PropertyGroup>
</Project>
