flowchart TD
	A["Agent Turn: messages + ChatOptions.Tools"] --> B{"Tools empty or<br/>NoneChatToolMode?"}
	B -->|"Yes"| Z["Forward original ChatOptions<br/>to inner IChatClient"]
	B -->|"No"| C["BuildDecisionState<br/>(last MaxContextMessages = 6)"]
	C --> D["PartitionTools: <br/>AlwaysIncluded / Required vs Candidates"]
	D --> E["Build BinaryDecisionQuestion per candidate<br/>(tool name + description)"]
	E --> F["IDecisionClient.GetDecisionAsync"]
	F --> |"Failure / timeout / empty"| G["Fail-open: retain all original tools"]
	G --> Z
	F -->|"DecisionResponse"| H["Keep candidates where<br/>TrueProbability >= 0.5"]
	H --> I["Merge with AlwaysIncluded & Required tools"]
	I --> J["Forward filtered ChatOptions<br/>to inner IChatClient"]
