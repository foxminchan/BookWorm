%%{init: {'theme': 'base', 'themeVariables': {'background': '#f5f5f5', 'primaryColor': '#ffffff', 'primaryTextColor': '#2d3142', 'primaryBorderColor': '#2d3142', 'secondaryColor': '#ececec', 'secondaryBorderColor': '#4f5d75', 'tertiaryColor': '#fdf2ee', 'tertiaryBorderColor': '#bf4520', 'lineColor': '#4f5d75', 'textColor': '#2d3142', 'clusterBkg': '#f8f9fa', 'clusterBorder': '#bfc0c0', 'fontFamily': 'Geist, system-ui, sans-serif'}}}%%
flowchart TD
	msg["Customer Message\n(AG-UI /ag-ui)"]
	validate["InputValidationExecutor\n(Deterministic Rules)"]
	reject1["Short-Circuit Rejection\n(Empty / Pattern Match)"]
	router["DecisionRouterExecutor\n(ChatRoutingDecisionService)"]
	model["FoundrySystemOneDecisionClient\n(Microsoft-Decision-1)"]
	partial["HandlePartialResponse\n(Keep Guardrails, Default Book)"]
	guard{"EvaluateGuardrails\n(Threshold 0.5)"}
	unsafe["Boundary Response\n(UnsafeInput / NonEnglish / OutOfScope)"]
	conf{"Route Confidence\n>= 0.6?"}
	hitl["RouteDisambiguationPort\n(HITL Disambiguation)"]
	agents["Specialist Handoff\n(Book / QA / Rating A2A)"]

	msg -->|"HTTP SSE"| validate
	validate -->|"Invalid"| reject1
	validate -->|"Valid"| router
	router --> |"HTTPS: /providers/microsoft/v1/systemone"| model
	model -->|"DecisionUnansweredException"| partial
	partial --> guard
	model -->|"DecisionResponse"| guard
	guard -->|"Any guardrail < 0.5"| unsafe
	guard -->|"All guardrails >= 0.5"| conf
	conf -->|"No (< 0.6)"| hitl
	hitl -->|"User choice"| agents
	conf -->|"Yes (>= 0.6)"| agents

	classDef focal fill:#fdf2ee,stroke:#bf4520,stroke-width:2px,color:#2d3142
	classDef service fill:#ffffff,stroke:#2d3142,stroke-width:1.2px,color:#2d3142
	classDef store fill:#ececec,stroke:#4f5d75,stroke-width:1.2px,color:#2d3142
	classDef input fill:#eef1f6,stroke:#5a6580,stroke-width:1.2px,color:#2d3142
	classDef ext fill:#f5f5f5,stroke:#949eb2,stroke-width:1px,stroke-dasharray:4 3,color:#4f5d75
	class guard focal
	class validate,reject1,router,partial,unsafe,conf,hitl,agents service
	class msg input
	class model ext
	linkStyle 5 stroke:#bf4520,stroke-width:2px
	linkStyle 6 stroke:#bf4520,stroke-width:2px
