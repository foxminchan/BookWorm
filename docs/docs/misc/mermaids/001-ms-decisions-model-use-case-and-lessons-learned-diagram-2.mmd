%%{init: {'theme': 'base', 'themeVariables': {'background': '#f5f5f5', 'primaryColor': '#ffffff', 'primaryTextColor': '#2d3142', 'primaryBorderColor': '#2d3142', 'secondaryColor': '#ececec', 'secondaryBorderColor': '#4f5d75', 'tertiaryColor': '#fdf2ee', 'tertiaryBorderColor': '#bf4520', 'lineColor': '#4f5d75', 'textColor': '#2d3142', 'clusterBkg': '#f8f9fa', 'clusterBorder': '#bfc0c0', 'fontFamily': 'Geist, system-ui, sans-serif'}}}%%
flowchart TD
	turn["Agent Turn\n(Messages + ChatOptions.Tools)"]
	empty{"Tools Empty or\nNoneChatToolMode?"}
	partition["PartitionTools\n(Last 6 Messages + Mandatory vs Candidates)"]
	decide["IDecisionClient\n(Microsoft-Decision-1)"]
	failopen["Fail-Open Fallback\n(Retain All Original Tools)"]
	filter["Keep Candidates\n(TrueProbability >= 0.5)"]
	merge["Merge Mandatory +\nSelected Candidate Tools"]
	chat["Inner IChatClient\n(Foundry ModelRouter)"]

	turn --> empty
	empty -->|"Yes"| chat
	empty -->|"No"| partition
	partition -->|"Binary questions"| decide
	decide -->|"Timeout / Error / Empty"| failopen
	failopen --> chat
	decide -->|"DecisionResponse"| filter
	filter --> merge
	merge --> chat

	classDef focal fill:#fdf2ee,stroke:#bf4520,stroke-width:2px,color:#2d3142
	classDef service fill:#ffffff,stroke:#2d3142,stroke-width:1.2px,color:#2d3142
	classDef store fill:#ececec,stroke:#4f5d75,stroke-width:1.2px,color:#2d3142
	classDef input fill:#eef1f6,stroke:#5a6580,stroke-width:1.2px,color:#2d3142
	classDef ext fill:#f5f5f5,stroke:#949eb2,stroke-width:1px,stroke-dasharray:4 3,color:#4f5d75
	class empty focal
	class partition,decide,failopen,filter,merge service
	class turn input
	class chat ext
	linkStyle 0 stroke:#bf4520,stroke-width:2px
	linkStyle 1 stroke:#bf4520,stroke-width:2px
