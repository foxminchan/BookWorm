flowchart TD
	orient["Day 1: orient and identify an owning area"]
	setup{"How much setup do you need?"}
	quick["Run the local quickstart"]
	detailed["Review the environment guide"]
	verify["Verify the dashboard and one application endpoint"]
	recover["Use the local troubleshooting guide"]
	week["Week 1: read workflow and engineering standards"]
	select["Choose a focused, well-owned change"]
	test["Select and run the relevant checks"]
	pr["Open a focused pull request"]
	learn["Use review feedback to plan the next change"]

	orient --> setup
	setup -->|"Fastest route"| quick
	setup -->|"More setup detail"| detailed
	quick --> verify
	detailed --> verify
	verify -->|"Blocked"| recover
	recover --> verify
	verify -->|"Ready"| week
	week --> select
	select --> test
	test --> pr
	pr --> learn

	classDef focal fill:#fdf2ee,stroke:#bf4520,stroke-width:2px,color:#2d3142
