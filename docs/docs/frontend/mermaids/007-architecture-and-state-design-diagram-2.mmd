flowchart LR
	ui["Feature Slices\n(Catalog, Shopping, Ordering, Reviews)"]
	rq["Server Query Cache\n(Normalized Keys & Hydration)"]
	jotai["Ephemeral Client State\n(Auth Flag, Basket Badge, Toggles)"]
	client["Resilient Transport & SSE\n(Retries, ETags, Backoff)"]
	copilot["Conversational Runtime\n(Storefront AI Assistant)"]
	gateway["API Gateway\n(Reverse Proxy)"]
	apis["Backend Capability APIs\n(Catalog, Basket, Ordering, Rating, Chat)"]

	ui -->|"Reads & mutates domain data"| rq
	ui -->|"Reads ephemeral UI state"| jotai
	jotai -->|"Auth-gated basket sync"| rq
	rq -->|"Typed requests + ETag headers"| client
	ui -->|"Streams AI responses"| copilot
	client -->|"HTTPS JSON & SSE"| gateway
	copilot -->|"HTTPS AG-UI + Bearer token"| gateway
	gateway -->|"Internal service routing"| apis

	classDef focal fill:#fdf2ee,stroke:#bf4520,stroke-width:2px,color:#2d3142
	classDef service fill:#ffffff,stroke:#2d3142,stroke-width:1.2px,color:#2d3142
	classDef input fill:#eef1f6,stroke:#5a6580,stroke-width:1.2px,color:#2d3142
	class ui focal
	class rq,jotai,client,gateway,apis service
	class copilot input
	linkStyle 0 stroke:#bf4520,stroke-width:2px
	linkStyle 1 stroke:#bf4520,stroke-width:2px
