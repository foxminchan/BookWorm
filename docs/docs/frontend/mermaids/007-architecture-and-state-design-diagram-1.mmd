flowchart TD
	app["Application Tier\nStorefront, Commerce, Backoffice"]
	domain["Domain Tier\nUI System, Customer Shell, Data Hooks, Auth, SEO, Validation"]
	foundation["Foundation Tier\nDomain Types, Environment Schemas, Telemetry, Utilities"]
	config["Configuration Tier\nLinting, Type-Checking, Test Harness, Build Presets"]

	app -->|"Consumes domain capabilities"| domain
	app -->|"Consumes core primitives"| foundation
	domain -->|"Consumes core primitives"| foundation
	app -.->|"Applies engineering presets"| config
	domain -.->|"Applies engineering presets"| config
	foundation -.->|"Applies engineering presets"| config

	classDef focal fill:#fdf2ee,stroke:#bf4520,stroke-width:2px,color:#2d3142
	classDef service fill:#ffffff,stroke:#2d3142,stroke-width:1.2px,color:#2d3142
	classDef input fill:#eef1f6,stroke:#5a6580,stroke-width:1.2px,color:#2d3142
	class app focal
	class foundation,config service
	class domain input
	linkStyle 0 stroke:#bf4520,stroke-width:2px
	linkStyle 1 stroke:#bf4520,stroke-width:2px
