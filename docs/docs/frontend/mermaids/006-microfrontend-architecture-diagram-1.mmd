architecture-beta
	group edge(internet)[Edge and Gateway]
	service browser(internet)[Customer and Staff Browsers] in edge
	service gateway(server)[API Gateway] in edge
	service manifest(disk)[Shared Route Manifest] in edge

	group zones(internet)[Frontend Surfaces]
	service storefront(server)[Storefront] in zones
	service commerce(server)[Commerce] in zones
	service backoffice(server)[Backoffice] in zones

	group backends(cloud)[Backend and Identity]
	service apis(server)[Capability APIs] in backends
	service entra(cloud)[Microsoft Entra ID] in backends

	browser:R --> L: gateway
	manifest:T --> B: gateway
	gateway:R --> L: storefront
	gateway:R --> L: commerce
	gateway:R --> L: backoffice
	gateway:B --> T: apis
	gateway:B --> T: entra
