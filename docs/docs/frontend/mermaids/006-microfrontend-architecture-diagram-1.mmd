flowchart LR
    browser["Customer Browser\n(Single HTTPS Origin)"]
    config["microfrontends.json\n(Shared Route Manifest)"]
    gateway["API Gateway\n(YARP Reverse Proxy)"]
    backends["Backend APIs\n(/catalog, /basket, /ordering, /rating, /chatting)"]
    entra["Microsoft Entra ID\n(/entra/*)"]
    backoffice["Backoffice\n(Next.js 16, /backoffice/*)"]
    commerce["Commerce\n(Next.js 16 MFE, /basket, /checkout/*, /account/*)"]
    storefront["Storefront\n(Next.js 16 MFE, Catch-All Fallback)"]

    browser -->|"HTTPS: Request"| gateway
    config -.->|"Build & Startup: Load routes"| gateway
    config -.->|"Next.js Config: Asset & link rules"| commerce
    config -.->|"Next.js Config: Fallback rules"| storefront
    gateway -->|"HTTP: Orders 0..4"| backends
    gateway -->|"HTTPS: Order 5"| entra
    gateway -->|"HTTP: X-Mfe-Zone=backoffice"| backoffice
    gateway -->|"HTTP: X-Mfe-Zone=commerce"| commerce
    gateway -->|"HTTP: X-Mfe-Zone=storefront"| storefront

	classDef focal fill:#fdf2ee,stroke:#bf4520,stroke-width:2px,color:#2d3142
	classDef service fill:#ffffff,stroke:#2d3142,stroke-width:1.2px,color:#2d3142
	classDef store fill:#ececec,stroke:#4f5d75,stroke-width:1.2px,color:#2d3142
	classDef input fill:#eef1f6,stroke:#5a6580,stroke-width:1.2px,color:#2d3142
	classDef ext fill:#f5f5f5,stroke:#949eb2,stroke-width:1px,stroke-dasharray:4 3,color:#4f5d75
	class gateway focal
	class backends service
	class browser,config,backoffice,commerce,storefront input
	class entra ext
	linkStyle 0 stroke:#bf4520,stroke-width:2px
	linkStyle 1 stroke:#bf4520,stroke-width:2px
