%%{init: {'theme': 'base', 'themeVariables': {'background': '#f5f5f5', 'primaryColor': '#ffffff', 'primaryTextColor': '#2d3142', 'primaryBorderColor': '#2d3142', 'secondaryColor': '#ececec', 'secondaryBorderColor': '#4f5d75', 'tertiaryColor': '#fdf2ee', 'tertiaryBorderColor': '#bf4520', 'lineColor': '#4f5d75', 'textColor': '#2d3142', 'clusterBkg': '#f8f9fa', 'clusterBorder': '#bfc0c0', 'fontFamily': 'Geist, system-ui, sans-serif'}}}%%
flowchart TD
	alert["Alert / Symptom\n(5xx, Latency, Stalled Orders, Missing Search)"]
	preflight["1. Pre-Flight Context\n(Subscription & Container App List)"]
	revisions["2. Revision & Replica Health\n(Active Revisions, Probes, Restarts)"]
	logs["3. Live Log Tail & KQL\n(Console Errors, System Events, DLQs)"]
	mitigate{"4. Contain & Mitigate"}
	rollback["Rollback Revision\n(Recent Deploy Regression)"]
	restart["Restart Revision / Fix RBAC\n(Transient / Identity Issue)"]
	scale["Scale Up / Raise Quotas\n(Saturation / 429 Throttling)"]
	verify["5. Verify Recovery\n(Healthy Replicas & Zero Errors)"]

	alert --> preflight
	preflight --> revisions
	revisions --> logs
	logs --> mitigate
	mitigate -->|"Bad Release"| rollback
	mitigate -->|"Stuck Worker / Auth"| restart
	mitigate -->|"Load / Quota"| scale
	rollback --> verify
	restart --> verify
	scale --> verify

	classDef focal fill:#fdf2ee,stroke:#bf4520,stroke-width:2px,color:#2d3142
	classDef service fill:#ffffff,stroke:#2d3142,stroke-width:1.2px,color:#2d3142
	classDef store fill:#ececec,stroke:#4f5d75,stroke-width:1.2px,color:#2d3142
	classDef input fill:#eef1f6,stroke:#5a6580,stroke-width:1.2px,color:#2d3142
	classDef ext fill:#f5f5f5,stroke:#949eb2,stroke-width:1px,stroke-dasharray:4 3,color:#4f5d75
	class alert,mitigate focal
	class preflight,revisions,logs,verify service
	class rollback,restart,scale input
	linkStyle 4 stroke:#bf4520,stroke-width:2px
	linkStyle 5 stroke:#bf4520,stroke-width:2px
	linkStyle 6 stroke:#bf4520,stroke-width:2px
