flowchart LR
	detect["Suspected Compromise /\nScheduled Rotation"]
	revoke["1. Revoke Old Credential\n(Partner Key, FIC, or Session Secret)"]
	issue["2. Issue & Store New Secret\n(Key Vault / CI Environment)"]
	rollout["3. Roll Out & Restart\n(Container App Revisions)"]
	audit["4. Audit & Verify\n(Activity Logs, Sign-In Logs, 200 OK)"]

	detect --> revoke
	revoke --> issue
	issue --> rollout
	rollout --> audit

