flowchart LR
	pg["PostgreSQL Flexible Server\n(Catalog, Ordering, Scheduler DBs)"]
	cosmos["Azure Cosmos DB\n(Rating Feedbacks)"]
	blob["Azure Blob Storage\n(Catalog Assets & Chat Sessions)"]
	qdrant["Qdrant Cloud\n(Derived Vector Index)"]

	pitr["Point-in-Time Restore\n(Geo-Redundant Backups)"]
	failover["Continuous Backup /\nRegion Failover"]
	softdel["Soft-Delete & Versioning\nRecovery"]
	reindex["Catalog Ingestion\nFull Re-Index"]

	pg -->|"PITR to Target Timestamp"| pitr
	cosmos -->|"Restore / Failover"| failover
	blob -->|"Undelete / Restore Version"| softdel
	pg -->|"Authoritative Catalog Data"| reindex
	reindex -->|"Rebuild Embeddings"| qdrant

	classDef focal fill:#fdf2ee,stroke:#bf4520,stroke-width:2px,color:#2d3142
	classDef service fill:#ffffff,stroke:#2d3142,stroke-width:1.2px,color:#2d3142
	classDef store fill:#ececec,stroke:#4f5d75,stroke-width:1.2px,color:#2d3142
	classDef input fill:#eef1f6,stroke:#5a6580,stroke-width:1.2px,color:#2d3142
	classDef ext fill:#f5f5f5,stroke:#949eb2,stroke-width:1px,stroke-dasharray:4 3,color:#4f5d75
	class pg,cosmos,blob,qdrant store
	class pitr,failover,softdel,reindex service
	linkStyle 0 stroke:#bf4520,stroke-width:2px
	linkStyle 3 stroke:#2d3142,stroke-width:1.5px
	linkStyle 4 stroke:#bf4520,stroke-width:2px
