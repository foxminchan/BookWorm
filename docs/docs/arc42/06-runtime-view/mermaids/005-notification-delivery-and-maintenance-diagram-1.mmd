sequenceDiagram
	autonumber
	participant Finance as Finance
	participant Broker as Kafka Broker
	participant Notification as Notification
	participant Redis as Redis
	participant SMTP as Mailpit or SendGrid
	participant DLQ as Notification Dead-Letter Queue

	Finance -->> Broker: Asynchronous email command
	Broker -->> Notification: Deliver command
	Notification ->> Redis: Claim event idempotency key

	alt Duplicate event identifier
		Redis -->> Notification: Key already exists
		Notification ->> Notification: Skip delivery
	else New event identifier
		Redis -->> Notification: Key acquired

		alt Recipient missing
			Notification ->> Notification: Skip delivery
		else Recipient available
			Notification ->> Notification: Render email
			Notification ->> SMTP: Synchronous SMTP submission

			alt Accepted
				SMTP -->> Notification: Relay accepted
			else Transient failure
				SMTP -->> Notification: Failure
				Notification ->> Notification: Retry with bounded backoff

				opt Retries exhausted
					Notification ->> Redis: Release idempotency key
					Notification -->> Broker: Retry or dead-letter
					Broker ->> DLQ: Retain exhausted command
				end
			end
		end
	end
