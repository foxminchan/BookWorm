%%{init: {'theme': 'base', 'themeVariables': {'background': '#f5f5f5', 'primaryTextColor': '#2d3142', 'lineColor': '#4f5d75', 'fontFamily': 'Geist, system-ui, sans-serif'}}}%%
flowchart LR

	subgraph request["Customer Request"]
		direction TB
		customer["Customer or Administrator"]
		gateway["API Gateway"]
		edge["Storefront, Commerce, and Backoffice"]
		customer -->|"HTTPS"| gateway
		gateway -->|"HTTPS"| edge
	end

	subgraph services["Synchronous Services"]
		direction TB
		sync["Ordering API<br/>Catalog API<br/>Basket API<br/>Rating API<br/>Chat API"]
	end

	subgraph eventWork["Event-Driven Work"]
		direction TB
		scheduler["Scheduler"]
		broker["Kafka Broker"]
		async["Finance<br/>Notification<br/>Catalog Ingestion"]
		scheduler -.->|"Scheduled trigger"| broker
		broker -.->|"Asynchronous delivery"| async
	end

	stores[("Authoritative and Derived State")]

	request -->|"Synchronous requests"| services
	services -->|"Direct data calls"| stores
	services -.->|"Asynchronous facts or commands"| eventWork
	eventWork -->|"State updates or side effects"| stores

	classDef focal fill:#fdf2ee,stroke:#bf4520,stroke-width:2px
	classDef syncNode fill:#ffffff,stroke:#2d3142,stroke-width:1.5px
	classDef asyncNode fill:#eef1f6,stroke:#5a6580,stroke-width:1.5px
	classDef storeNode fill:#ececec,stroke:#4f5d75
	class sync focal
	class customer,gateway,edge syncNode
	class broker,scheduler,async asyncNode
	class stores storeNode
	linkStyle 0,1,4,5,7 stroke:#bf4520,stroke-width:2px
	linkStyle 2,3,6 stroke:#5a6580,stroke-width:2px,stroke-dasharray:5 4
	style request fill:#f8f9fa,stroke:#bfc0c0
	style services fill:#fdf2ee,stroke:#bf4520,stroke-width:2px
	style eventWork fill:#f8f9fa,stroke:#bfc0c0
