flowchart TB

	subgraph External["External Trust Boundary"]
		User["Customer / Staff"]
		Edge["Public Entry and Gateway"]
	end

	subgraph Product["Application Trust Boundary"]
		FE["Authenticated Experience"]
		API["Protected APIs and Workers"]
		Policy["Role, Scope, and Tool Policy"]
	end

	subgraph Automation["Delegated Trust Boundary"]
		Agent["AI Agent or Integration"]
		Workload["Federated Workload Identity"]
		Privacy["PII Screening and Redaction"]
	end

	subgraph Protected["Protected Systems"]
		Data["Authoritative Data"]
		Model["External Model"]
		Secrets["Managed Secrets"]
		Logs["Redacted Telemetry"]
	end

	User -->|"Authenticate"| Edge
	Edge -->|"Verify identity and audience"| FE
	FE -->|"Authorized request"| API
	API -->|"Evaluate role and permission"| Policy
	Policy -->|"Permitted operation"| Data
	API -->|"Tool or model request"| Agent
	Agent -->|"Claims-bound workload identity"| Workload
	Workload -->|"Minimum privilege"| Model
	Agent --> Privacy
	Privacy -->|"Anonymized prompt and result"| Model
	API -->|"Classified data without raw secrets"| Logs
	Agent -->|"Redacted operational context"| Logs
	Policy -->|"Managed credential lookup"| Secrets

