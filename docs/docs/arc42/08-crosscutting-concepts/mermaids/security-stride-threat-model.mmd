	Client -->|"sign in"| IdP
	IdP -->|"access token"| Client
	Client --> |"S: impersonation or token replay; T: request tampering; D: request flood"| OrderingAPI
	Policy --> |"E: excessive role or scope"| Endpoint
	Client -->|"user content"| Validation
	Guardrail --> |"T: prompt manipulation"| PIIIn
	PIIIn --> |"I: residual sensitive data"| Model
	Model --> |"T: manipulated response; I: sensitive output"| PIIOut --> Agent
	MCP --> |"T: untrusted tool result; E: overbroad tool access"| Agent
	Endpoint --> |"R: attribution gap; I: sensitive fields"| Logs
	Agent --> |"R: attribution gap; I: sensitive telemetry"| Logs
