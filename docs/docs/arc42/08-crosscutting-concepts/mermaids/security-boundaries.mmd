---
title: Security boundaries
---
flowchart LR

	subgraph API["Ordering API boundary"]
		Customer["Customer or client"] -->|"sign in"| EntraID["Microsoft Entra ID"]
		EntraID -->|"access token"| OrderingAPI["Ordering API"]
		OrderingAPI --> Validation["JWT validation"]
		Validation --> Policy["Authorization policy"]
		Policy -->|"authenticated user + role + any allowed scope"| Endpoint["Authorized endpoint"]
		Policy -->|"missing identity, role, or scope"| Deny["Reject request"]
	end

	subgraph AI["Chat and Rating agent boundary"]
		User["User or tool content"] --> Input["Input validation"]
		Input --> PIIIn["Presidio PII anonymization"]
		PIIIn --> Model["Model client"]
		Model --> PIIOut["Presidio response anonymization"]
		PIIOut --> Caller["Calling service"]
		Input -->|"rejected input"| Reject["Return rejection without agent handoff"]
	end
