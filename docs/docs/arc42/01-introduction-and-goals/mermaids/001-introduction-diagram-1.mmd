flowchart LR
	customer["Customer<br/>(Storefront & Commerce)"]
	admin["Store Administrator<br/>(Backoffice & Quartz UI)"]

	subgraph bookworm["BookWorm Platform"]
		catalog["Catalog<br/>(Catalog API, Ingestion)"]
		shopping["Shopping<br/>(Basket API)"]
		ordering["Ordering<br/>(Ordering API, Finance)"]
		reviews["Reviews<br/>(Rating API)"]
		conversational["Conversational<br/>(Chat API, MCP Tools)"]
		platform["Platform<br/>(Notification, Scheduler)"]
	end

	entra["Microsoft Entra ID<br/>(Identity & Agent IDs)"]
	foundry["Microsoft Foundry<br/>(LLM, Decision & Embeddings)"]
	smtp["SendGrid / Mailpit<br/>(SMTP Email Delivery)"]

	customer -->|"HTTPS via YARP"| bookworm
	admin -->|"HTTPS via YARP / OIDC"| bookworm
	bookworm <-->|"OAuth2 / OIDC / OBO"| entra
	conversational --> |"HTTPS: Model & Decision API"| foundry
	catalog --> |"HTTPS: Embeddings API"| foundry
	reviews --> |"HTTPS: LLM Summary API"| foundry
	platform -->|"SMTP (Port 587)"| smtp

	style bookworm fill:#f1f3f7,stroke:#6b7690,stroke-width:1.5px,stroke-dasharray:4 3,color:#2d3142

	classDef focal fill:#fdf2ee,stroke:#bf4520,stroke-width:2px,color:#2d3142
	classDef service fill:#ffffff,stroke:#2d3142,stroke-width:1.5px,color:#2d3142
	classDef input fill:#e4e8ef,stroke:#5a6580,stroke-width:1.5px,color:#2d3142
	classDef ext fill:#ffffff,stroke:#5a6580,stroke-width:1.5px,stroke-dasharray:4 3,color:#2d3142
	class foundry focal
	class shopping,ordering service
	class customer,admin,catalog,reviews,conversational,platform input
	class entra,smtp ext
	linkStyle 3 stroke:#bf4520,stroke-width:2px
	linkStyle 4 stroke:#bf4520,stroke-width:2px
	linkStyle 5 stroke:#bf4520,stroke-width:2px
