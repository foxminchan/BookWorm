classDiagram
	direction LR

class OrderOrchestrator:::focal {
	+Run()
}

class Order:::domain {
	+OrderStatus Status
	+bool BasketDeleted
	+int TimeoutRetryCount
	+int MaxAttempts
	+Complete()
	+Cancel()
	+RecordTimeoutRetry()
}

class OrderLifecycleDecider:::domain {
	+IsTerminal(status) bool
	-Decide(command, state)
}

class OrderStatus:::state {
	<<enumeration>>
	Placed
	BasketDeletionFailed
	Completed
	Cancelled
	Failed
}

class IOrderWorkflowStep:::strategy {
	<<interface>>
	+CanHandle(winner, events) bool
	+ExecuteAsync(context) outcome
}

class PlaceOrderTimeoutStep:::strategy {
	+CanHandle() bool
	+ExecuteAsync() outcome
}

class OrderStepContext:::context {
	+Order
	+Events
	+Compensations
}

class OrderSagaCompensations:::strategy {
	+AddCompensation()
	+CompensateAsync()
	+Clear()
}
	class Entity:::shared

class IAggregateRoot:::shared {
	<<interface>>
}

	Order --|> Entity
	Order ..|> IAggregateRoot
	Order --> OrderStatus: tracks coordination outcome
	Order --> OrderLifecycleDecider: validates transitions
	OrderOrchestrator --> Order: coordinates
	OrderOrchestrator --> IOrderWorkflowStep: dispatches
	PlaceOrderTimeoutStep ..|> IOrderWorkflowStep
	IOrderWorkflowStep ..> OrderStepContext : handles
	OrderStepContext --> Order: provides workflow state
	OrderOrchestrator *-- OrderSagaCompensations : tracks recovery

