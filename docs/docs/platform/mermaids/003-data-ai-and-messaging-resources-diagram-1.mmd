architecture-beta
	group services(logos:dotnet)[Application Workloads]
	service catalog(logos:dotnet)[Catalog and Ingestion] in services
	service ordering(logos:dotnet)[Ordering and Basket] in services
	service rating(logos:dotnet)[Rating API] in services
	service chat(logos:dotnet)[Chat API] in services
	service finance(logos:azure-icon)[Finance] in services
	service platform_svc(logos:dotnet)[Scheduler and Notification] in services

	group azure_stores(logos:azure-icon)[Azure Managed Stores]
	service postgres(logos:postgresql)[PostgreSQL] in azure_stores
	service redis(logos:redis)[Managed Redis] in azure_stores
	service cosmos(logos:azure-icon)[Cosmos DB] in azure_stores
	service blob(disk)[Blob Storage] in azure_stores
	service dts(logos:azure-icon)[Durable Task Scheduler] in azure_stores

	group ai_ext(cloud)[AI and External Services]
	service qdrant(logos:qdrant-icon)[Qdrant Cloud] in ai_ext
	service foundry(logos:microsoft-icon)[Microsoft Foundry] in ai_ext
	service kafka(logos:kafka-icon)[Kafka Broker] in ai_ext
	service smtp(logos:sendgrid-icon)[SMTP Relay] in ai_ext

	catalog:R --> L: postgres
	postgres:R --> L: ordering
	catalog:B --> T: qdrant
	qdrant:R --> L: blob
	ordering:B --> T: redis
	redis:R --> L: cosmos
	rating:L --> R: cosmos
	rating:B --> T: foundry
	chat:R --> L: foundry
	platform_svc:T --> B: postgres
	platform_svc:R --> L: kafka
	kafka:R --> L: smtp
	finance:T --> B: kafka
	finance:R --> L: dts
