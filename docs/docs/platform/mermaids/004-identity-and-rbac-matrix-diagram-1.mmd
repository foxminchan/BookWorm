architecture-beta
	group clients(internet)[Users and Frontends]
	service user(internet)[Customer or Staff] in clients
	service fe(logos:nextjs-icon)[Storefront, Commerce, Backoffice] in clients

	group idp(logos:oauth)[Identity Provider]
	service entra(logos:oauth)[Microsoft Entra ID] in idp
	service agent_id(logos:microsoft-icon)[Entra Agent Identities] in idp

	group workloads(logos:dotnet)[Backend Services]
	service apis(logos:dotnet)[BookWorm APIs] in workloads
	service agents(logos:dotnet)[Chat and Rating Agents] in workloads
	service mi(logos:azure-icon)[Managed Identities] in workloads

	group resources(logos:azure-icon)[Protected Azure Resources]
	service stores(logos:postgresql)[PostgreSQL, Redis, Cosmos, Storage] in resources
	service foundry(logos:microsoft-icon)[Microsoft Foundry] in resources

	user:R --> L: fe
	fe:B --> T: entra
	fe:R --> L: apis
	apis:B --> T: agents
	entra:R --> L: agents
	agents:R --> L: agent_id
	apis:R --> L: mi
	mi:R --> L: stores
	stores:B --> T: foundry
