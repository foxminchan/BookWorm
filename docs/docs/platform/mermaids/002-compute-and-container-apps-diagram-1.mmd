architecture-beta
	group edge(internet)[Edge Tier]
	service gateway(server)[API Gateway] in edge
	service quartz_ui(server)[Quartz Dashboard] in edge

	group frontend(logos:nextjs-icon)[Frontend Tier]
	service storefront(logos:nextjs-icon)[Storefront] in frontend
	service commerce(logos:nextjs-icon)[Commerce] in frontend
	service backoffice(logos:nextjs-icon)[Backoffice] in frontend

	group api(logos:dotnet)[API Tier]
	junction j_api in api
	service catalog(logos:dotnet)[Catalog API] in api
	service basket(logos:dotnet)[Basket API] in api
	service ordering(logos:dotnet)[Ordering API] in api
	service chatting(logos:dotnet)[Chat API] in api
	service rating(logos:dotnet)[Rating API] in api
	service mcptools(logos:dotnet)[MCP Tools] in api

	group async_tier(logos:azure-icon)[Workers and Functions Tier]
	service finance(logos:azure-icon)[Finance] in async_tier
	service ingestion(logos:azure-icon)[Catalog Ingestion] in async_tier
	service notification(logos:dotnet)[Notification] in async_tier
	service scheduler(logos:dotnet)[Scheduler] in async_tier

	group privacy(logos:docker-icon)[Privacy Tier]
	service analyzer(logos:docker-icon)[Presidio Analyzer] in privacy
	service anonymizer(logos:docker-icon)[Presidio Anonymizer] in privacy

	gateway:R --> L: storefront
	storefront:R --> L: commerce
	commerce:R --> L: backoffice
	gateway:B --> T: j_api
	j_api:R --> L: catalog
	catalog:R --> L: basket
	basket:R --> L: ordering
	j_api:B --> T: chatting
	chatting:R --> L: rating
	rating:R --> L: mcptools
	rating:B --> T: analyzer
	analyzer:R --> L: anonymizer
	ordering:B --> T: finance
	finance:R --> L: ingestion
	ingestion:R --> L: notification
	notification:R --> L: scheduler
	scheduler:B --> T: quartz_ui
