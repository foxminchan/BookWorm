architecture-beta
	group ingress(internet)[Public Ingress]
	service gateway(server)[API Gateway] in ingress

	group sync_apis(logos:dotnet)[Core APIs]
	junction j_sync in sync_apis
	service catalog(logos:dotnet)[Catalog API] in sync_apis
	service basket(logos:dotnet)[Basket API] in sync_apis
	service ordering(logos:dotnet)[Ordering API] in sync_apis
	service rating(logos:dotnet)[Rating API] in sync_apis
	service chat(logos:dotnet)[Chat API] in sync_apis

	group internal_ai(cloud)[Internal Tools and AI]
	service mcptools(logos:dotnet)[MCP Tools] in internal_ai
	service presidio(logos:docker-icon)[Presidio Sidecars] in internal_ai
	service foundry(logos:microsoft-icon)[Microsoft Foundry] in internal_ai

	group event_fabric(logos:kafka-icon)[Asynchronous Event Fabric]
	service kafka(logos:kafka-icon)[Kafka Broker] in event_fabric
	service finance(logos:azure-icon)[Finance] in event_fabric
	service notification(logos:dotnet)[Notification] in event_fabric
	service scheduler(logos:dotnet)[Scheduler] in event_fabric
	service ingestion(logos:azure-icon)[Catalog Ingestion] in event_fabric

	gateway:R --> L: j_sync
	j_sync:R --> L: catalog
	catalog:R --> L: mcptools
	mcptools:R --> L: foundry
	j_sync:T --> B: basket
	basket:R --> L: ordering
	j_sync:B --> T: rating
	rating:R --> L: chat
	chat:R --> L: presidio
	rating:B --> T: kafka
	kafka:R --> L: finance
	finance:R --> L: notification
	kafka:B --> T: scheduler
	scheduler:R --> L: ingestion
