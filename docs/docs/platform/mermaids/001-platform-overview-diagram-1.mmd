architecture-beta
	group edge(internet)[Edge and Ingress]
	service users(internet)[Customers and Staff] in edge
	service gateway(server)[API Gateway] in edge
	service quartz_ui(server)[Quartz Dashboard] in edge

	group aca(logos:azure-icon)[Container Apps Environment]
	service frontends(logos:nextjs-icon)[Frontend Apps] in aca
	service apis(logos:dotnet)[Backend APIs] in aca
	service workers(logos:dotnet)[Workers and Functions] in aca
	service presidio(logos:docker-icon)[Presidio Sidecars] in aca

	group shared(logos:azure-icon)[Shared Platform]
	service obs(logos:opentelemetry-icon)[Log Analytics and Dashboard] in shared
	service acr(disk)[Container Registry] in shared

	group azure_data(logos:azure-icon)[Azure Managed Data and AI]
	service stores(logos:postgresql)[PostgreSQL, Redis, Cosmos, Storage] in azure_data
	service foundry(logos:microsoft-icon)[Microsoft Foundry and DTS] in azure_data

	group external(cloud)[External Providers]
	service entra(logos:oauth)[Microsoft Entra ID] in external
	service brokers(logos:kafka-icon)[Kafka, Qdrant and SMTP] in external

	users:R --> L: gateway
	gateway:R --> L: frontends
	frontends:R --> L: entra
	users:B --> T: quartz_ui
	gateway:B --> T: apis
	apis:R --> L: presidio
	presidio:R --> L: foundry
	apis:B --> T: workers
	workers:R --> L: stores
	stores:R --> L: brokers
	obs:R --> L: workers
	obs:B --> T: acr
