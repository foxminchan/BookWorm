flowchart LR
	ordering["Ordering API\n(PostgreSQL Outbox)"] --> |"Kafka: ordering.user-checked-out"| finance["Finance\n(Durable Functions OrderOrchestrator)"]
	finance --> |"Kafka: finance.place-order"| basket["Basket API\n(Redis Delete)"]
	finance --> |"Kafka: finance.place-order"| notify["Notification\n(Redis Guard + MailKit SMTP)"]
	basket --> |"Kafka: basket.delete-complete / failed"| finance
	finance --> |"Kafka: finance.delete-basket-complete / failed"| ordering
	notify -->|"SMTP 587"| smtp["Mailpit (Local) /\nSendGrid SMTP (Azure)"]
	finance --> |"Timeout exhausted: finance.cancel-order"| notify

	classDef focal fill:#fdf2ee,stroke:#bf4520,stroke-width:2px,color:#2d3142
	classDef service fill:#ffffff,stroke:#2d3142,stroke-width:1.2px,color:#2d3142
	classDef store fill:#ececec,stroke:#4f5d75,stroke-width:1.2px,color:#2d3142
	classDef input fill:#eef1f6,stroke:#5a6580,stroke-width:1.2px,color:#2d3142
	classDef ext fill:#f5f5f5,stroke:#949eb2,stroke-width:1px,stroke-dasharray:4 3,color:#4f5d75
	class finance focal
	class ordering,basket store
	class notify,smtp ext
	linkStyle 0 stroke:#bf4520,stroke-width:2px
	linkStyle 1 stroke:#bf4520,stroke-width:2px
