---
interface Props {
	passingFitnessRules: number;
	totalFitnessChecks: number;
}

const { passingFitnessRules, totalFitnessChecks } = Astro.props;
---

<div
	id="report-status-banner"
	class="flex flex-col justify-between gap-3 rounded-xl border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-card-bg))] p-4 shadow-xs sm:flex-row sm:items-center"
>
	<div class="flex items-center gap-3">
		<span id="report-status-dot" class="relative flex h-2.5 w-2.5 shrink-0">
			<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-amber-500 opacity-75"></span>
			<span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-amber-500"></span>
		</span>
		<div>
			<p id="report-status-title" class="text-xs font-semibold text-[rgb(var(--ec-page-text))] sm:text-sm">
				Probing hosted CI test report availability...
			</p>
			<p id="report-status-desc" class="text-[11px] text-[rgb(var(--ec-page-text-muted))]">
				Checking Allure and TUnit HTML artifacts published to GitHub Pages from CI pipelines.
			</p>
		</div>
	</div>
	<div id="report-status-badges" class="flex flex-wrap items-center gap-2 text-xs">
		<span class="rounded-lg border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-page-bg))] px-3 py-1 font-mono text-[11px] text-[rgb(var(--ec-page-text-muted))]">
			Fitness: {passingFitnessRules}/{totalFitnessChecks} Passed
		</span>
		<span
			id="tunit-count-badge"
			class="rounded-lg border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-page-bg))] px-3 py-1 font-mono text-[11px] text-[rgb(var(--ec-page-text-muted))]"
		>
			21 Backend Test Projects
		</span>
	</div>
</div>

<script>
	function initReportStatusProbe() {
		const base = import.meta.env.BASE_URL.replace(/\/$/, "");
		const banner = document.getElementById("report-status-banner");
		const dot = document.getElementById("report-status-dot");
		const title = document.getElementById("report-status-title");
		const desc = document.getElementById("report-status-desc");
		const tunitBadge = document.getElementById("tunit-count-badge");

		if (!banner || banner.dataset.initialized === "true") return;
		banner.dataset.initialized = "true";

		Promise.allSettled([
			fetch(`${base}/reports/index.html`).then(async (res) => {
				const html = res.ok ? await res.text() : "";
				return res.ok && !html.includes("404: Not found");
			}),
			fetch(`${base}/reports/tunit/manifest.json`).then(async (res) => {
				if (!res.ok) return null;
				const data = await res.json();
				return Array.isArray(data) ? data.length : null;
			}),
		]).then(([allureRes, tunitRes]) => {
			if (!banner.isConnected) return;
			const allureAvailable = allureRes.status === "fulfilled" && allureRes.value === true;
			const tunitCount = tunitRes.status === "fulfilled" ? tunitRes.value : null;

			if (tunitCount !== null && tunitBadge) {
				tunitBadge.textContent = `${tunitCount} Published TUnit Reports`;
			}

			if (allureAvailable) {
				if (dot) {
					dot.innerHTML = `
						<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-500 opacity-75"></span>
						<span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
					`;
				}
				if (title) {
					title.textContent = "Hosted Allure & TUnit CI Reports Online";
				}
				if (desc) {
					desc.textContent =
						"All CI test artifacts are live. Click any test suite below to inspect full execution logs.";
				}
			} else {
				if (title) {
					title.textContent = "Architecture Metrics Active · CI HTML Reports Built in Deployment";
				}
				if (desc) {
					desc.textContent =
						"Catalog metrics and fitness invariants are live. Full Allure & TUnit HTML reports are generated and linked in the docs.yml pipeline.";
				}
			}
		});
	}

	document.addEventListener("astro:page-load", initReportStatusProbe);
	if (document.readyState !== "loading") {
		initReportStatusProbe();
	}
</script>
