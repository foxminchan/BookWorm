---
import type {
	MessageBreakdownItem,
	TeamOwnershipStat,
	VerificationLayer,
} from "../../_data/catalogMetrics";

interface Props {
	base: string;
	totalMessagesCount: number;
	channelsCount: number;
	messageBreakdown: MessageBreakdownItem[];
	verificationLayers: VerificationLayer[];
	teamsCount: number;
	usersCount: number;
	teamOwnershipStats: TeamOwnershipStat[];
	maxTeamAssets: number;
	domainsCount: number;
	containersCount: number;
	adrsCount: number;
	firstTeamId: string;
}

const {
	base,
	totalMessagesCount,
	channelsCount,
	messageBreakdown,
	verificationLayers,
	teamsCount,
	usersCount,
	teamOwnershipStats,
	maxTeamAssets,
	domainsCount,
	containersCount,
	adrsCount,
	firstTeamId,
} = Astro.props;
---

<section id="section-charts" aria-label="Architecture and Verification Charts" class="space-y-4">
	<div>
		<h2 class="text-lg font-bold text-[rgb(var(--ec-page-text))]">
			Visual Analytics & Distribution
		</h2>
		<p class="text-xs text-[rgb(var(--ec-page-text-muted))]">
			Message protocol composition, multi-tier test pyramid, and team governance breakdown.
		</p>
	</div>

	<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
		<!-- Chart 1: Message Contract Breakdown -->
		<div class="flex flex-col justify-between rounded-2xl border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-card-bg))] p-6 shadow-xs">
			<div class="space-y-5">
				<div class="flex items-center justify-between">
					<div>
						<h3 class="text-sm font-bold text-[rgb(var(--ec-page-text))]">
							Contract Composition
						</h3>
						<p class="text-xs text-[rgb(var(--ec-page-text-muted))]">
							{totalMessagesCount} schemas across {channelsCount} Kafka/HTTP/gRPC channels
						</p>
					</div>
					<span class="rounded-lg bg-[rgb(var(--ec-page-bg))] px-2.5 py-1 text-xs font-mono font-bold text-[rgb(var(--ec-page-text))]">
						{totalMessagesCount} Total
					</span>
				</div>

				<!-- Proportional Bar -->
				<div class="space-y-2">
					<div class="flex h-3 w-full overflow-hidden rounded-full bg-[rgb(var(--ec-page-bg))] p-0.5">
						{
							messageBreakdown.map((item) => (
								<div
									class={`${item.colorClass} first:rounded-l-full last:rounded-r-full transition-all`}
									style={`width: ${(item.count / Math.max(totalMessagesCount, 1)) * 100}%`}
									title={`${item.label}: ${item.count} (${item.percent}%)`}
								/>
							))
						}
					</div>
					<div class="flex justify-between text-[11px] text-[rgb(var(--ec-page-text-muted))]">
						{
							messageBreakdown.map((item) => (
								<span class="flex items-center gap-1.5 font-medium">
									<span class={`h-2 w-2 rounded-full ${item.colorClass}`} />
									{item.shortLabel}: {item.percent}%
								</span>
							))
						}
					</div>
				</div>

				<!-- Detailed Items -->
				<div class="space-y-2.5">
					{
						messageBreakdown.map((item) => (
							<a
								href={item.href}
								class="group block rounded-xl border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-page-bg))] p-3 transition-all hover:border-[rgb(var(--ec-accent))] hover:bg-[rgb(var(--ec-card-bg))]"
							>
								<div class="flex items-center justify-between text-xs">
									<span class="font-semibold text-[rgb(var(--ec-page-text))] group-hover:text-[rgb(var(--ec-accent))]">
										{item.label}
									</span>
									<span class={`font-mono font-bold ${item.textClass}`}>
										{item.count} ({item.percent}%)
									</span>
								</div>
								<p class="mt-1 text-[11px] text-[rgb(var(--ec-page-text-muted))]">
									{item.description}
								</p>
							</a>
						))
					}
				</div>
			</div>

			<div class="mt-5 flex items-center justify-between border-t border-[rgb(var(--ec-page-border))] pt-4 text-xs text-[rgb(var(--ec-page-text-muted))]">
				<span>Kafka · HTTP · gRPC</span>
				<a href={`${base}/discover/events`} class="font-semibold text-[rgb(var(--ec-accent))] hover:underline">
					Explore schemas →
				</a>
			</div>
		</div>

		<!-- Chart 2: Test Verification Pyramid -->
		<div class="flex flex-col justify-between rounded-2xl border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-card-bg))] p-6 shadow-xs">
			<div class="space-y-5">
				<div class="flex items-center justify-between">
					<div>
						<h3 class="text-sm font-bold text-[rgb(var(--ec-page-text))]">
							Test Verification Pyramid
						</h3>
						<p class="text-xs text-[rgb(var(--ec-page-text-muted))]">
							Continuous quality defense in CI workflows
						</p>
					</div>
					<span class="rounded-lg bg-[rgb(var(--ec-page-bg))] px-2.5 py-1 text-xs font-mono font-bold text-[rgb(var(--ec-page-text))]">
						4 Tiers
					</span>
				</div>

				<div class="space-y-3">
					{
						verificationLayers.map((layer) => (
							<div class="rounded-xl border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-page-bg))] p-3">
								<div class="flex items-center justify-between text-xs">
									<span class="font-semibold text-[rgb(var(--ec-page-text))]">
										{layer.tier}
									</span>
									<code class="rounded bg-[rgb(var(--ec-card-bg))] px-1.5 py-0.5 text-[10px] text-[rgb(var(--ec-page-text-muted))]">
										{layer.workflow}
									</code>
								</div>
								<div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-[rgb(var(--ec-card-bg))]">
									<div
										class={`h-full rounded-full ${layer.barColor}`}
										style={`width: ${layer.widthPercent}%`}
									/>
								</div>
								<div class="mt-2 flex items-center justify-between text-[11px]">
									<span class="font-medium text-[rgb(var(--ec-page-text))] font-mono">
										{layer.unit}
									</span>
									<span class="text-[rgb(var(--ec-page-text-muted))]">
										{layer.tools}
									</span>
								</div>
							</div>
						))
					}
				</div>
			</div>

			<div class="mt-5 flex items-center justify-between border-t border-[rgb(var(--ec-page-border))] pt-4 text-xs text-[rgb(var(--ec-page-text-muted))]">
				<span>TUnit · Vitest · Pact · Playwright</span>
				<a href={`${base}/custom/reports/tunit`} class="font-semibold text-[rgb(var(--ec-accent))] hover:underline">
					Browse TUnit →
				</a>
			</div>
		</div>

		<!-- Chart 3: Team Governance & Ownership -->
		<div class="flex flex-col justify-between rounded-2xl border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-card-bg))] p-6 shadow-xs">
			<div class="space-y-5">
				<div class="flex items-center justify-between">
					<div>
						<h3 class="text-sm font-bold text-[rgb(var(--ec-page-text))]">
							Team Governance
						</h3>
						<p class="text-xs text-[rgb(var(--ec-page-text-muted))]">
							Ownership across {teamsCount} teams & {usersCount} engineering leads
						</p>
					</div>
					<span class="rounded-lg bg-emerald-500/10 px-2.5 py-1 text-xs font-semibold text-emerald-500">
						100% Owned
					</span>
				</div>

				<div class="space-y-2.5">
					{
						teamOwnershipStats.map((team) => (
							<a
								href={`${base}/docs/teams/${team.id}`}
								class="group block rounded-xl border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-page-bg))] p-3 transition-all hover:border-[rgb(var(--ec-accent))] hover:bg-[rgb(var(--ec-card-bg))]"
							>
								<div class="flex items-center justify-between text-xs">
									<span class="font-semibold text-[rgb(var(--ec-page-text))] group-hover:text-[rgb(var(--ec-accent))]">
										{team.name}
									</span>
									<span class="font-mono font-bold text-[rgb(var(--ec-accent))]">
										{team.totalAssets} assets
									</span>
								</div>
								<div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-[rgb(var(--ec-card-bg))]">
									<div
										class="h-full rounded-full bg-[rgb(var(--ec-accent))]"
										style={`width: ${Math.max(Math.round((team.totalAssets / maxTeamAssets) * 100), 12)}%`}
									/>
								</div>
								<div class="mt-2 flex flex-wrap gap-1.5 text-[10px] text-[rgb(var(--ec-page-text-muted))]">
									<span class="rounded bg-[rgb(var(--ec-card-bg))] px-1.5 py-0.5">
										{team.servicesCount} Services
									</span>
									<span class="rounded bg-[rgb(var(--ec-card-bg))] px-1.5 py-0.5">
										{team.messagesCount} Messages
									</span>
									<span class="rounded bg-[rgb(var(--ec-card-bg))] px-1.5 py-0.5">
										{team.containersCount} Stores
									</span>
								</div>
							</a>
						))
					}
				</div>

				<div class="grid grid-cols-3 gap-2 text-center">
					<a
						href={`${base}/discover/domains`}
						class="rounded-xl border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-page-bg))] p-2.5 transition-colors hover:border-[rgb(var(--ec-accent))]"
					>
						<p class="text-base font-extrabold font-mono text-[rgb(var(--ec-page-text))]">{domainsCount}</p>
						<p class="text-[10px] text-[rgb(var(--ec-page-text-muted))]">Domains</p>
					</a>
					<a
						href={`${base}/discover/containers`}
						class="rounded-xl border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-page-bg))] p-2.5 transition-colors hover:border-[rgb(var(--ec-accent))]"
					>
						<p class="text-base font-extrabold font-mono text-[rgb(var(--ec-page-text))]">{containersCount}</p>
						<p class="text-[10px] text-[rgb(var(--ec-page-text-muted))]">Data Stores</p>
					</a>
					<div class="rounded-xl border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-page-bg))] p-2.5">
						<p class="text-base font-extrabold font-mono text-[rgb(var(--ec-page-text))]">{adrsCount}</p>
						<p class="text-[10px] text-[rgb(var(--ec-page-text-muted))]">Decisions</p>
					</div>
				</div>
			</div>

			<div class="mt-5 flex items-center justify-between border-t border-[rgb(var(--ec-page-border))] pt-4 text-xs text-[rgb(var(--ec-page-text-muted))]">
				<span>Accountable Ownership</span>
				<a href={`${base}/docs/teams/${firstTeamId}`} class="font-semibold text-[rgb(var(--ec-accent))] hover:underline">
					View teams →
				</a>
			</div>
		</div>
	</div>
</section>
