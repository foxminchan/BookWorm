---
interface Props {
	fitnessScorePercent: number;
	passingFitnessRules: number;
	totalFitnessChecks: number;
	adrsCount: number;
	domainsCount: number;
	servicesCount: number;
	internalServicesCount: number;
	systemsCount: number;
	containersCount: number;
	agentsCount: number;
	entitiesCount: number;
	flowsCount: number;
	channelsCount: number;
	totalMessagesCount: number;
	eventsCount: number;
	commandsCount: number;
	queriesCount: number;
	totalAutomatedSuites: number;
}

const {
	fitnessScorePercent,
	passingFitnessRules,
	totalFitnessChecks,
	adrsCount,
	domainsCount,
	servicesCount,
	internalServicesCount,
	systemsCount,
	containersCount,
	agentsCount,
	entitiesCount,
	flowsCount,
	channelsCount,
	totalMessagesCount,
	eventsCount,
	commandsCount,
	queriesCount,
	totalAutomatedSuites,
} = Astro.props;
---

<section id="section-kpis" aria-label="Executive Key Performance Indicators" class="space-y-4">
	<div class="flex items-center justify-between">
		<h2 class="text-xs font-bold tracking-wider text-[rgb(var(--ec-page-text-muted))] uppercase">
			Platform Posture at a Glance
		</h2>
		<span class="text-[11px] text-[rgb(var(--ec-page-text-muted))]">
			Verified against repository specifications & CI runs
		</span>
	</div>

	<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
		<!-- KPI 1: Fitness -->
		<div class="flex flex-col justify-between rounded-2xl border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-card-bg))] p-5 shadow-xs transition-shadow hover:shadow-md">
			<div>
				<div class="flex items-center justify-between">
					<span class="text-xs font-medium text-[rgb(var(--ec-page-text-muted))]">
						Architecture Fitness
					</span>
					<span class="rounded-full bg-emerald-500/10 px-2.5 py-0.5 text-xs font-semibold text-emerald-500">
						{fitnessScorePercent}% Compliant
					</span>
				</div>
				<div class="mt-3 flex items-baseline gap-2">
					<span class="text-3xl font-extrabold tracking-tight text-[rgb(var(--ec-page-text))] font-mono">
						{passingFitnessRules}/{totalFitnessChecks}
					</span>
					<span class="text-xs text-[rgb(var(--ec-page-text-muted))]">
						rules passing
					</span>
				</div>
				<div class="mt-3.5 h-2 w-full overflow-hidden rounded-full bg-[rgb(var(--ec-page-bg))]">
					<div
						class="h-full rounded-full bg-emerald-500 transition-all duration-500"
						style={`width: ${fitnessScorePercent}%`}
					></div>
				</div>
			</div>
			<p class="mt-4 border-t border-[rgb(var(--ec-page-border))] pt-3 text-[11px] text-[rgb(var(--ec-page-text-muted))]">
				<strong class="font-semibold text-[rgb(var(--ec-page-text))]">{adrsCount}</strong> recorded ADRs · 0 circular command cycles
			</p>
		</div>

		<!-- KPI 2: Service Footprint -->
		<div class="flex flex-col justify-between rounded-2xl border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-card-bg))] p-5 shadow-xs transition-shadow hover:shadow-md">
			<div>
				<div class="flex items-center justify-between">
					<span class="text-xs font-medium text-[rgb(var(--ec-page-text-muted))]">
						Domain & Service Footprint
					</span>
					<span class="rounded-full bg-[rgb(var(--ec-accent-subtle))] px-2.5 py-0.5 text-xs font-semibold text-[rgb(var(--ec-accent))]">
						{domainsCount} Domains
					</span>
				</div>
				<div class="mt-3 flex items-baseline gap-2">
					<span class="text-3xl font-extrabold tracking-tight text-[rgb(var(--ec-page-text))] font-mono">
						{servicesCount}
					</span>
					<span class="text-xs text-[rgb(var(--ec-page-text-muted))]">
						services ({internalServicesCount} core · {servicesCount - internalServicesCount} ext)
					</span>
				</div>
				<div class="mt-3.5 flex flex-wrap gap-1.5 text-[11px] text-[rgb(var(--ec-page-text-muted))]">
					<span class="rounded-md bg-[rgb(var(--ec-page-bg))] px-2 py-0.5 font-medium">
						{systemsCount} Systems
					</span>
					<span class="rounded-md bg-[rgb(var(--ec-page-bg))] px-2 py-0.5 font-medium">
						{containersCount} Stores
					</span>
					<span class="rounded-md bg-[rgb(var(--ec-page-bg))] px-2 py-0.5 font-medium">
						{agentsCount} AI Agents
					</span>
				</div>
			</div>
			<p class="mt-4 border-t border-[rgb(var(--ec-page-border))] pt-3 text-[11px] text-[rgb(var(--ec-page-text-muted))]">
				<strong class="font-semibold text-[rgb(var(--ec-page-text))]">{entitiesCount}</strong> domain entities · <strong class="font-semibold text-[rgb(var(--ec-page-text))]">{flowsCount}</strong> user flow
			</p>
		</div>

		<!-- KPI 3: Contracts Surface -->
		<div class="flex flex-col justify-between rounded-2xl border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-card-bg))] p-5 shadow-xs transition-shadow hover:shadow-md">
			<div>
				<div class="flex items-center justify-between">
					<span class="text-xs font-medium text-[rgb(var(--ec-page-text-muted))]">
						Contract & Message Volume
					</span>
					<span class="rounded-full bg-sky-500/10 px-2.5 py-0.5 text-xs font-semibold text-sky-500">
						{channelsCount} Channels
					</span>
				</div>
				<div class="mt-3 flex items-baseline gap-2">
					<span class="text-3xl font-extrabold tracking-tight text-[rgb(var(--ec-page-text))] font-mono">
						{totalMessagesCount}
					</span>
					<span class="text-xs text-[rgb(var(--ec-page-text-muted))]">
						versioned schemas
					</span>
				</div>
				<div class="mt-3.5 flex h-2 w-full overflow-hidden rounded-full bg-[rgb(var(--ec-page-bg))]">
					<div
						class="h-full bg-amber-500"
						style={`width: ${(eventsCount / totalMessagesCount) * 100}%`}
						title={`Events: ${eventsCount}`}
					></div>
					<div
						class="h-full bg-sky-500"
						style={`width: ${(commandsCount / totalMessagesCount) * 100}%`}
						title={`Commands: ${commandsCount}`}
					></div>
					<div
						class="h-full bg-emerald-500"
						style={`width: ${(queriesCount / totalMessagesCount) * 100}%`}
						title={`Queries: ${queriesCount}`}
					></div>
				</div>
			</div>
			<p class="mt-4 border-t border-[rgb(var(--ec-page-border))] pt-3 text-[11px] text-[rgb(var(--ec-page-text-muted))]">
				<span class="text-amber-500 font-medium">{eventsCount}E</span> · <span class="text-sky-500 font-medium">{commandsCount}C</span> · <span class="text-emerald-500 font-medium">{queriesCount}Q</span>
			</p>
		</div>

		<!-- KPI 4: Automated Verification -->
		<div class="flex flex-col justify-between rounded-2xl border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-card-bg))] p-5 shadow-xs transition-shadow hover:shadow-md">
			<div>
				<div class="flex items-center justify-between">
					<span class="text-xs font-medium text-[rgb(var(--ec-page-text-muted))]">
						Automated Verification
					</span>
					<span class="rounded-full bg-indigo-500/10 px-2.5 py-0.5 text-xs font-semibold text-indigo-500">
						4 CI Feeds
					</span>
				</div>
				<div class="mt-3 flex items-baseline gap-2">
					<span class="text-3xl font-extrabold tracking-tight text-[rgb(var(--ec-page-text))] font-mono">
						{totalAutomatedSuites}
					</span>
					<span class="text-xs text-[rgb(var(--ec-page-text-muted))]">
						automated test suites
					</span>
				</div>
				<div class="mt-3.5 flex flex-wrap gap-1.5 text-[11px] text-[rgb(var(--ec-page-text-muted))]">
					<span class="rounded-md bg-[rgb(var(--ec-page-bg))] px-2 py-0.5 font-medium">9 Unit</span>
					<span class="rounded-md bg-[rgb(var(--ec-page-bg))] px-2 py-0.5 font-medium">12 Pact</span>
					<span class="rounded-md bg-[rgb(var(--ec-page-bg))] px-2 py-0.5 font-medium">1 Arch</span>
					<span class="rounded-md bg-[rgb(var(--ec-page-bg))] px-2 py-0.5 font-medium">2 E2E</span>
				</div>
			</div>
			<p class="mt-4 border-t border-[rgb(var(--ec-page-border))] pt-3 text-[11px] text-[rgb(var(--ec-page-text-muted))]">
				100% of internal services covered by TUnit & Vitest
			</p>
		</div>
	</div>
</section>
