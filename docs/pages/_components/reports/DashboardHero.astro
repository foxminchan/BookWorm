---
interface Props {
	base: string;
	domainsCount: number;
	servicesCount: number;
	totalMessagesCount: number;
}

const { base, domainsCount, servicesCount, totalMessagesCount } = Astro.props;
---

<header class="relative overflow-hidden rounded-2xl border border-[rgb(var(--ec-page-border))] bg-gradient-to-b from-[rgb(var(--ec-card-bg))] via-[rgb(var(--ec-card-bg))] to-[rgb(var(--ec-page-bg))] p-7 shadow-sm sm:p-9">
	<div class="relative z-10 flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
		<div class="max-w-3xl space-y-3">
			<div class="flex flex-wrap items-center gap-2.5">
				<span class="inline-flex items-center gap-2 rounded-full border border-[rgb(var(--ec-accent)/0.3)] bg-[rgb(var(--ec-accent-subtle))] px-3 py-1 text-xs font-semibold text-[rgb(var(--ec-accent))] shadow-xs">
					<span class="relative flex h-2 w-2">
						<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[rgb(var(--ec-accent))] opacity-75"></span>
						<span class="relative inline-flex h-2 w-2 rounded-full bg-[rgb(var(--ec-accent))]"></span>
					</span>
					Architecture & Quality Intelligence
				</span>
				<span class="rounded-full border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-page-bg))] px-3 py-1 text-xs font-medium text-[rgb(var(--ec-page-text-muted))]">
					QA · PM · Director · Dev
				</span>
			</div>

			<h1 class="text-3xl font-extrabold tracking-tight text-[rgb(var(--ec-page-text))] sm:text-4xl">
				Platform Quality & Architecture Dashboard
			</h1>

			<p class="text-sm leading-relaxed text-[rgb(var(--ec-page-text-muted))] sm:text-base">
				Continuously verified architecture fitness, bidirectional message contracts, and multi-tier test pipelines across <strong class="font-semibold text-[rgb(var(--ec-page-text))]">{domainsCount} business domains</strong>, <strong class="font-semibold text-[rgb(var(--ec-page-text))]">{servicesCount} services</strong>, and <strong class="font-semibold text-[rgb(var(--ec-page-text))]">{totalMessagesCount} contracts</strong>.
			</p>
		</div>

		<!-- Executive Action Buttons -->
		<div class="flex flex-wrap items-center gap-3">
			<a
				href="https://sonarcloud.io/summary/overall?id=foxminchan_BookWorm&branch=main"
				target="_blank"
				rel="noopener noreferrer"
				class="group inline-flex items-center gap-2 rounded-xl border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-page-bg))] px-4 py-2.5 text-xs font-semibold text-[rgb(var(--ec-page-text))] shadow-xs transition-all hover:border-[rgb(var(--ec-accent))] hover:bg-[rgb(var(--ec-card-bg))]"
			>
				<span>SonarCloud Quality Gate</span>
				<svg class="h-3.5 w-3.5 text-[rgb(var(--ec-page-text-muted))] transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
				</svg>
			</a>
			<a
				href="https://scorecard.dev/viewer/?uri=github.com/foxminchan/BookWorm"
				target="_blank"
				rel="noopener noreferrer"
				class="group inline-flex items-center gap-2 rounded-xl border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-page-bg))] px-4 py-2.5 text-xs font-semibold text-[rgb(var(--ec-page-text))] shadow-xs transition-all hover:border-[rgb(var(--ec-accent))] hover:bg-[rgb(var(--ec-card-bg))]"
			>
				<span>OpenSSF Scorecard</span>
				<svg class="h-3.5 w-3.5 text-[rgb(var(--ec-page-text-muted))] transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
				</svg>
			</a>
			<a
				href={`${base}/reports/index.html`}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-2 rounded-xl bg-[rgb(var(--ec-accent))] px-4 py-2.5 text-xs font-semibold text-[rgb(var(--ec-accent-text))] shadow-md transition-all hover:opacity-90 hover:shadow-lg"
			>
				<span>Open Unified Allure</span>
				<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
				</svg>
			</a>
		</div>
	</div>
</header>
