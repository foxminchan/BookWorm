---
import type { FitnessCheckSummary } from "../../_data/catalogMetrics";

interface Props {
	fitnessChecks: FitnessCheckSummary[];
	passingFitnessRules: number;
}

const { fitnessChecks, passingFitnessRules } = Astro.props;
---

<section id="section-fitness" aria-label="Architecture Fitness Functions" class="space-y-4">
	<div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
		<div>
			<h2 class="text-lg font-bold text-[rgb(var(--ec-page-text))]">
				Architecture Fitness Functions
			</h2>
			<p class="text-xs text-[rgb(var(--ec-page-text-muted))]">
				Continuous architectural invariants enforced by <code class="rounded bg-[rgb(var(--ec-card-bg))] px-1.5 py-0.5 font-mono text-[11px]">eventcatalog fitness check</code> in CI (<code class="rounded bg-[rgb(var(--ec-card-bg))] px-1.5 py-0.5 font-mono text-[11px]">docs.yml</code>).
			</p>
		</div>
		<span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 px-3 py-1 text-xs font-semibold text-emerald-500">
			✓ {passingFitnessRules} of {fitnessChecks.length} Invariants Passing
		</span>
	</div>

	<div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
		{
			fitnessChecks.map((check) => {
				const passed = check.violations.length === 0;
				const pct = Math.round(
					(check.passedCount / Math.max(check.totalChecked, 1)) * 100
				);
				return (
					<div class="flex flex-col justify-between rounded-2xl border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-card-bg))] p-5 shadow-xs transition-shadow hover:shadow-md">
						<div class="space-y-3">
							<div class="flex items-center justify-between gap-2">
								<span class="rounded-md bg-[rgb(var(--ec-page-bg))] px-2 py-0.5 text-[11px] font-semibold text-[rgb(var(--ec-page-text-muted))]">
									{check.category}
								</span>
								<div class="flex items-center gap-1.5">
									<span
										class={`rounded-full px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider ${
											check.severity === "error"
												? "bg-rose-500/10 text-rose-500"
												: "bg-amber-500/10 text-amber-500"
										}`}
									>
										{check.severity}
									</span>
									<span
										class={`rounded-full px-2 py-0.5 text-[10px] font-bold ${
											passed
												? "bg-emerald-500/10 text-emerald-500"
												: "bg-rose-500/10 text-rose-500"
										}`}
									>
										{passed ? "PASS" : `${check.violations.length} VIOLATION`}
									</span>
								</div>
							</div>

							<h3 class="text-sm font-bold text-[rgb(var(--ec-page-text))]">
								{check.name}
							</h3>
							<p class="text-xs leading-relaxed text-[rgb(var(--ec-page-text-muted))]">
								{check.description}
							</p>
						</div>

						<div class="mt-4 space-y-2 border-t border-[rgb(var(--ec-page-border))] pt-3">
							<div class="flex items-center justify-between text-xs font-mono">
								<span class="text-[rgb(var(--ec-page-text-muted))]">Coverage</span>
								<span class="font-semibold text-[rgb(var(--ec-page-text))]">
									{check.passedCount}/{check.totalChecked} ({pct}%)
								</span>
							</div>
							<div class="h-1.5 w-full overflow-hidden rounded-full bg-[rgb(var(--ec-page-bg))]">
								<div
									class={`h-full rounded-full ${passed ? "bg-emerald-500" : "bg-rose-500"}`}
									style={`width: ${pct}%`}
								/>
							</div>
							{check.violations.length > 0 && (
								<p class="text-[11px] text-rose-500 font-medium">
									Violations: {check.violations.join(", ")}
								</p>
							)}
						</div>
					</div>
				);
			})
		}
	</div>
</section>
