---
import { REPORT_SUITES, RESULT_FEEDS } from "../../_data/reports";

interface Props {
	base: string;
}

const { base } = Astro.props;
---

<section id="section-suites" aria-label="Published Test Report Dashboards" class="space-y-4">
	<div>
		<h2 class="text-lg font-bold text-[rgb(var(--ec-page-text))]">
			Published Allure & TUnit Explorers
		</h2>
		<p class="text-xs text-[rgb(var(--ec-page-text-muted))]">
			Interactive test execution dashboards and raw CI artifacts.
		</p>
	</div>

	<div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-5">
		{
			REPORT_SUITES.map((suite) => (
				<div class="flex flex-col justify-between rounded-2xl border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-card-bg))] p-5 shadow-xs transition-shadow hover:shadow-md">
					<div>
						<div class="flex items-center justify-between gap-2">
							<span class="rounded-full bg-[rgb(var(--ec-accent-subtle))] px-2.5 py-0.5 text-xs font-semibold text-[rgb(var(--ec-accent))]">
								{suite.badge}
							</span>
							<code class="rounded bg-[rgb(var(--ec-page-bg))] px-1.5 py-0.5 font-mono text-[10px] text-[rgb(var(--ec-page-text-muted))]">
								{suite.workflow}
							</code>
						</div>
						<h3 class="mt-3 text-sm font-bold text-[rgb(var(--ec-page-text))]">
							{suite.name}
						</h3>
						<p class="mt-1.5 text-xs leading-relaxed text-[rgb(var(--ec-page-text-muted))]">
							{suite.description}
						</p>
					</div>

					<div class="mt-5 flex items-center justify-between border-t border-[rgb(var(--ec-page-border))] pt-3 text-xs">
						<a
							href={`${base}/custom/reports/${suite.id}`}
							class="font-semibold text-[rgb(var(--ec-accent))] hover:underline"
						>
							View embedded →
						</a>
						<a
							href={`${base}${suite.reportUrl}`}
							target="_blank"
							rel="noopener noreferrer"
							class="text-[rgb(var(--ec-page-text-muted))] hover:text-[rgb(var(--ec-page-text))]"
						>
							Standalone ↗
						</a>
					</div>
				</div>
			))
		}

		<div class="flex flex-col justify-between rounded-2xl border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-card-bg))] p-5 shadow-xs transition-shadow hover:shadow-md">
			<div>
				<div class="flex items-center justify-between gap-2">
					<span class="rounded-full bg-[rgb(var(--ec-accent-subtle))] px-2.5 py-0.5 text-xs font-semibold text-[rgb(var(--ec-accent))]">
						BE · TUnit
					</span>
					<code class="rounded bg-[rgb(var(--ec-page-bg))] px-1.5 py-0.5 font-mono text-[10px] text-[rgb(var(--ec-page-text-muted))]">
						sonar.yml
					</code>
				</div>
				<h3 class="mt-3 text-sm font-bold text-[rgb(var(--ec-page-text))]">
					TUnit HTML Reports
				</h3>
				<p class="mt-1.5 text-xs leading-relaxed text-[rgb(var(--ec-page-text-muted))]">
					Self-contained per-project HTML test execution reports for all backend test assemblies.
				</p>
			</div>

			<div class="mt-5 flex items-center justify-between border-t border-[rgb(var(--ec-page-border))] pt-3 text-xs">
				<a
					href={`${base}/custom/reports/tunit`}
					class="font-semibold text-[rgb(var(--ec-accent))] hover:underline"
				>
					Browse 21 projects →
				</a>
				<span class="font-mono text-[10px] text-[rgb(var(--ec-page-text-muted))]">tunit-report</span>
			</div>
		</div>
	</div>

	<!-- CI Feeds Bar -->
	<div class="grid grid-cols-1 gap-3 pt-2 sm:grid-cols-2 lg:grid-cols-4">
		{
			RESULT_FEEDS.map((feed) => (
				<div class="rounded-xl border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-card-bg))] p-3.5 shadow-xs">
					<div class="flex items-center justify-between">
						<p class="text-xs font-bold text-[rgb(var(--ec-page-text))]">{feed.name}</p>
						<span class="h-2 w-2 rounded-full bg-emerald-500" title="Active CI Feed" />
					</div>
					<p class="mt-1 text-[11px] text-[rgb(var(--ec-page-text-muted))]">{feed.scope}</p>
					<div class="mt-2.5 flex flex-wrap gap-1.5 text-[10px] text-[rgb(var(--ec-page-text-muted))]">
						<code class="rounded bg-[rgb(var(--ec-page-bg))] px-1.5 py-0.5 font-mono">
							{feed.artifact}
						</code>
						<code class="rounded bg-[rgb(var(--ec-page-bg))] px-1.5 py-0.5 font-mono">
							{feed.workflow}
						</code>
					</div>
				</div>
			))
		}
	</div>
</section>
