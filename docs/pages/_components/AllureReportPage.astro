---
import Layout from "@catalog/layouts/Layout.astro";
import ReportsNav from "./ReportsNav.astro";
import type { AllureReportSuite } from "../_data/reports";

type Props = {
	suite: AllureReportSuite;
	isDefault?: boolean;
};

const { suite, isDefault = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const reportUrl = `${base}${suite.reportUrl}`;
---

<Layout title={suite.name} description={suite.description} sidebar={false} fullWidth={true}>
	<div class="flex h-[calc(100vh-var(--ec-header-offset,4rem))] flex-col">
		<div class="border-b border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-page-bg))] px-6 py-4">
			<div class="mx-auto flex max-w-7xl flex-col gap-3">
				<div class="flex flex-wrap items-center justify-between gap-2">
					<div>
						<h1 class="text-xl font-bold text-[rgb(var(--ec-page-text))]">{suite.name}</h1>
						<p class="text-xs text-[rgb(var(--ec-page-text-muted))]">{suite.description}</p>
					</div>
					<div class="flex items-center gap-2">
						<button
							id="allure-back-summary"
							type="button"
							class="hidden cursor-pointer items-center gap-1 rounded-lg border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-card-bg))] px-3 py-1.5 text-xs font-medium text-[rgb(var(--ec-page-text))] transition-colors hover:border-[rgb(var(--ec-accent))]"
						>
							← Back to summary
						</button>
						<a
							id="allure-standalone-link"
							href={reportUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-1 rounded-lg border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-card-bg))] px-3 py-1.5 text-xs font-medium text-[rgb(var(--ec-page-text))] transition-colors hover:border-[rgb(var(--ec-accent))]"
						>
							Open standalone ↗
						</a>
					</div>
				</div>
				<ReportsNav />
			</div>
		</div>

		<div class="relative flex-1 bg-[rgb(var(--ec-page-bg))]">
			<iframe
				id="allure-frame"
				title={suite.name}
				data-report-url={reportUrl}
				class="hidden h-full w-full border-0"
			></iframe>

			<div
				id="allure-loading"
				class="flex h-full flex-col items-center justify-center p-8 text-center text-sm text-[rgb(var(--ec-page-text-muted))]"
			>
				Loading report...
			</div>

			<div
				id="allure-fallback"
				class="hidden h-full flex-col items-center justify-center p-8 text-center"
			>
				<div
					class="max-w-md rounded-xl border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-card-bg))] p-6"
				>
					<h2 class="text-lg font-semibold text-[rgb(var(--ec-page-text))]">
						Report not generated locally
					</h2>
					<p class="mt-2 text-sm text-[rgb(var(--ec-page-text-muted))]">
						Allure static HTML reports are built in CI (<code class="text-xs">docs.yml</code>) and
						deployed to <code class="text-xs">{suite.reportUrl}</code> on GitHub Pages.
					</p>
					{
						!isDefault && (
							<a
								href={`${base}/custom/reports`}
								class="mt-4 inline-block rounded-lg bg-[rgb(var(--ec-button-bg))] px-4 py-2 text-sm font-medium text-[rgb(var(--ec-button-text))] transition-colors hover:bg-[rgb(var(--ec-button-bg-hover))]"
							>
								Back to Unified Test Report
							</a>
						)
					}
				</div>
			</div>
		</div>
	</div>

	<script>
		import "../_scripts/allure-report";
	</script>
</Layout>
