---
import Layout from "@catalog/layouts/Layout.astro";
import ReportsNav from "./ReportsNav.astro";
import type { AllureReportSuite } from "../_data/reports";

type Props = {
	suite: AllureReportSuite;
	isDefault?: boolean;
};

const { suite, isDefault = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const reportUrl = `${base}${suite.reportUrl}`;
---

<Layout title={suite.name} description={suite.description} sidebar={false} fullWidth={true}>
	<div class="flex h-[calc(100vh-var(--ec-header-offset,4rem))] flex-col">
		<div class="border-b border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-page-bg))] px-6 py-4">
			<div class="mx-auto flex max-w-7xl flex-col gap-3">
				<div class="flex flex-wrap items-center justify-between gap-2">
					<div>
						<h1 class="text-xl font-bold text-[rgb(var(--ec-page-text))]">{suite.name}</h1>
						<p class="text-xs text-[rgb(var(--ec-page-text-muted))]">{suite.description}</p>
					</div>
					<div class="flex items-center gap-2">
						<button
							id="allure-back-summary"
							type="button"
							class="hidden cursor-pointer items-center gap-1 rounded-lg border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-card-bg))] px-3 py-1.5 text-xs font-medium text-[rgb(var(--ec-page-text))] transition-colors hover:border-[rgb(var(--ec-accent))]"
						>
							← Back to summary
						</button>
						<a
							id="allure-standalone-link"
							href={reportUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-1 rounded-lg border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-card-bg))] px-3 py-1.5 text-xs font-medium text-[rgb(var(--ec-page-text))] transition-colors hover:border-[rgb(var(--ec-accent))]"
						>
							Open standalone ↗
						</a>
					</div>
				</div>
				<ReportsNav />
			</div>
		</div>

		<div class="relative flex-1 bg-[rgb(var(--ec-page-bg))]">
			<iframe
				id="allure-frame"
				title={suite.name}
				data-report-url={reportUrl}
				class="hidden h-full w-full border-0"
			></iframe>

			<div
				id="allure-loading"
				class="flex h-full flex-col items-center justify-center p-8 text-center text-sm text-[rgb(var(--ec-page-text-muted))]"
			>
				Loading report...
			</div>

			<div
				id="allure-fallback"
				class="hidden h-full flex-col items-center justify-center p-8 text-center"
			>
				<div
					class="max-w-md rounded-xl border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-card-bg))] p-6"
				>
					<h2 class="text-lg font-semibold text-[rgb(var(--ec-page-text))]">
						Report not generated locally
					</h2>
					<p class="mt-2 text-sm text-[rgb(var(--ec-page-text-muted))]">
						Allure static HTML reports are built in CI (<code class="text-xs">docs.yml</code>) and
						deployed to <code class="text-xs">{suite.reportUrl}</code> on GitHub Pages.
					</p>
					{
						!isDefault && (
							<a
								href={`${base}/custom/reports`}
								class="mt-4 inline-block rounded-lg bg-[rgb(var(--ec-button-bg))] px-4 py-2 text-sm font-medium text-[rgb(var(--ec-button-text))] transition-colors hover:bg-[rgb(var(--ec-button-bg-hover))]"
							>
								Back to Unified Test Report
							</a>
						)
					}
				</div>
			</div>
		</div>
	</div>

	<script>
		function showFallback(loading: HTMLElement | null, fallback: HTMLElement | null) {
			loading?.classList.add("hidden");
			if (fallback) {
				fallback.classList.remove("hidden");
				fallback.classList.add("flex");
			}
		}

		function normalizeReportPath(pathname: string) {
			return pathname.replace(/\/index\.html$/i, "").replace(/\/+$/, "");
		}

		function keepNavigationInsideIframe(
			frame: HTMLIFrameElement,
			initialReportUrl: string,
			backButton: HTMLButtonElement | null,
			standaloneLink: HTMLAnchorElement | null,
		) {
			const initialPath = normalizeReportPath(
				new URL(initialReportUrl, window.location.origin).pathname,
			);

			frame.addEventListener("load", () => {
				try {
					const win = frame.contentWindow;
					const doc = frame.contentDocument;
					if (!win || !doc) return;

					const currentUrl = new URL(win.location.href);
					const isAtSummary = normalizeReportPath(currentUrl.pathname) === initialPath;

					if (backButton) {
						backButton.classList.toggle("hidden", isAtSummary);
						backButton.classList.toggle("inline-flex", !isAtSummary);
					}
					if (standaloneLink) {
						standaloneLink.href = currentUrl.href;
					}

					doc.addEventListener(
						"click",
						(event) => {
							if (
								event.defaultPrevented ||
								event.button !== 0 ||
								event.metaKey ||
								event.ctrlKey ||
								event.shiftKey ||
								event.altKey
							) {
								return;
							}

							const anchor = (event.target as Element | null)?.closest?.(
								"a[href]",
							) as HTMLAnchorElement | null;
							if (!anchor || anchor.target !== "_blank") return;

							const resolvedUrl = new URL(anchor.href, doc.baseURI);
							if (resolvedUrl.origin === window.location.origin) {
								anchor.target = "_self";
							}
						},
						true,
					);

					const originalOpen = win.open.bind(win);
					win.open = (targetUrl?: string | URL, target?: string, features?: string) => {
						if (targetUrl) {
							try {
								const resolvedUrl = new URL(targetUrl.toString(), doc.baseURI);
								if (resolvedUrl.origin === window.location.origin) {
									win.location.assign(resolvedUrl.href);
									return win;
								}
							} catch {
								// Fall through to default window.open
							}
						}
						return originalOpen(targetUrl, target, features);
					};
				} catch {
					// Ignore cross-origin access errors
				}
			});

			backButton?.addEventListener("click", () => {
				frame.src = initialReportUrl;
			});
		}

		function loadAllureReport() {
			const frame = document.getElementById("allure-frame") as HTMLIFrameElement | null;
			const fallback = document.getElementById("allure-fallback");
			const loading = document.getElementById("allure-loading");
			const backButton = document.getElementById(
				"allure-back-summary",
			) as HTMLButtonElement | null;
			const standaloneLink = document.getElementById(
				"allure-standalone-link",
			) as HTMLAnchorElement | null;
			const url = frame?.dataset.reportUrl;

			if (!frame || !fallback || !url || frame.dataset.initialized === "true") return;
			frame.dataset.initialized = "true";

			keepNavigationInsideIframe(frame, url, backButton, standaloneLink);

			fetch(url)
				.then(async (res) => {
					if (!frame.isConnected) return;
					if (!res.ok) {
						showFallback(loading, fallback);
						return;
					}
					const html = await res.text();
					if (!frame.isConnected) return;
					if (html.includes("404: Not found") || html.includes("data-not-found")) {
						showFallback(loading, fallback);
						return;
					}
					frame.src = url;
					frame.classList.remove("hidden");
					loading?.classList.add("hidden");
					fallback.classList.add("hidden");
				})
				.catch(() => {
					if (!frame.isConnected) return;
					showFallback(loading, fallback);
				});
		}

		document.addEventListener("astro:page-load", loadAllureReport);
		if (document.readyState !== "loading") {
			loadAllureReport();
		}
	</script>
</Layout>
