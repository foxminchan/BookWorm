---
import AllureReportPage from "../_components/AllureReportPage.astro";
import {
	DEFAULT_REPORT_SUITE_ID,
	REPORT_SUITES,
	type AllureReportSuite,
} from "../_data/reports";

export function getStaticPaths() {
	return REPORT_SUITES.map((suite) => ({
		params: { suite: suite.id },
		props: { suite },
	}));
}

type Props = {
	suite: AllureReportSuite;
};

const suite =
	Astro.props.suite ?? REPORT_SUITES.find((item) => item.id === Astro.params.suite);

if (!suite) {
	return new Response(null, { status: 404 });
}
---

<AllureReportPage suite={suite} isDefault={suite.id === DEFAULT_REPORT_SUITE_ID} />
