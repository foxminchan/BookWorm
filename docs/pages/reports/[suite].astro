---
import Layout from "@catalog/layouts/Layout.astro";
import ReportsNav from "../_components/ReportsNav.astro";
import { REPORT_SUITES, type AllureReportSuite } from "../_data/reports";

export function getStaticPaths() {
	return REPORT_SUITES.map((suite) => ({
		params: { suite: suite.id },
		props: { suite },
	}));
}

type Props = {
	suite: AllureReportSuite;
};

const suite =
	Astro.props.suite ?? REPORT_SUITES.find((item) => item.id === Astro.params.suite);

if (!suite) {
	return new Response(null, { status: 404 });
}
---

<Layout title={suite.name} description={suite.description} sidebar={false} fullWidth={true}>
	<div class="flex h-[calc(100vh-4rem)] flex-col">
		<div class="border-b border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-page-bg))] px-6 py-4">
			<div class="mx-auto flex max-w-7xl flex-col gap-3">
				<div class="flex flex-wrap items-center justify-between gap-2">
					<div>
						<h1 class="text-xl font-bold text-[rgb(var(--ec-page-text))]">{suite.name}</h1>
						<p class="text-xs text-[rgb(var(--ec-page-text-muted))]">{suite.description}</p>
					</div>
					<a
						href={suite.reportUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-1 rounded-lg border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-card-bg))] px-3 py-1.5 text-xs font-medium text-[rgb(var(--ec-page-text))] hover:border-[rgb(var(--ec-accent))]"
					>
						Open standalone ↗
					</a>
				</div>
				<ReportsNav />
			</div>
		</div>

		<div class="relative flex-1 bg-[rgb(var(--ec-page-bg))]">
			<iframe
				id="allure-frame"
				title={suite.name}
				data-report-url={suite.reportUrl}
				class="hidden h-full w-full border-0"
			></iframe>

			<div
				id="allure-fallback"
				class="flex h-full flex-col items-center justify-center p-8 text-center"
			>
				<div
					class="max-w-md rounded-xl border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-card-bg))] p-6"
				>
					<h2 class="text-lg font-semibold text-[rgb(var(--ec-page-text))]">
						Report not generated locally
					</h2>
					<p class="mt-2 text-sm text-[rgb(var(--ec-page-text-muted))]">
						Allure static HTML reports are built in CI (<code class="text-xs">docs.yml</code>) and
						deployed to <code class="text-xs">{suite.reportUrl}</code> on GitHub Pages.
					</p>
					<a
						href="/custom/reports"
						class="mt-4 inline-block rounded-lg bg-[rgb(var(--ec-accent))] px-4 py-2 text-sm font-medium text-[rgb(var(--ec-accent-text))]"
					>
						Back to Test Reports Overview
					</a>
				</div>
			</div>
		</div>
	</div>

	<script>
		const frame = document.getElementById("allure-frame") as HTMLIFrameElement | null;
		const fallback = document.getElementById("allure-fallback");
		const url = frame?.dataset.reportUrl;

		if (frame && fallback && url) {
			fetch(url)
				.then(async (res) => {
					if (!res.ok) return;
					const html = await res.text();
					if (html.includes("404: Not found")) return;
					frame.src = url;
					frame.classList.remove("hidden");
					fallback.classList.add("hidden");
				})
				.catch(() => {
					// Keep fallback visible when report is unavailable
				});
		}
	</script>
</Layout>
