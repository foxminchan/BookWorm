---
import Layout from "@catalog/layouts/Layout.astro";
import ReportsNav from "../_components/ReportsNav.astro";
import DashboardHero from "../_components/reports/DashboardHero.astro";
import ExecutiveKpiGrid from "../_components/reports/ExecutiveKpiGrid.astro";
import FitnessScorecardSection from "../_components/reports/FitnessScorecardSection.astro";
import PublishedSuitesSection from "../_components/reports/PublishedSuitesSection.astro";
import ReportStatusBanner from "../_components/reports/ReportStatusBanner.astro";
import RoleLensSection from "../_components/reports/RoleLensSection.astro";
import ServiceMatrixSection from "../_components/reports/ServiceMatrixSection.astro";
import VisualAnalyticsSection from "../_components/reports/VisualAnalyticsSection.astro";
import { loadCatalogDashboardData } from "../_data/catalogMetrics";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const dashboard = await loadCatalogDashboardData(base);
---

<Layout
	title="Quality & Architecture Intelligence"
	description="Enterprise quality, governance, contract verification, and test execution analytics across BookWorm microservices."
	sidebar={false}
>
	<div class="mx-auto max-w-7xl space-y-10 pb-16 font-sans antialiased">
		<DashboardHero
			base={base}
			domainsCount={dashboard.counts.domains}
			servicesCount={dashboard.counts.services}
			totalMessagesCount={dashboard.counts.totalMessages}
		/>

		<ReportsNav />

		<ReportStatusBanner
			passingFitnessRules={dashboard.passingFitnessRules}
			totalFitnessChecks={dashboard.fitnessChecks.length}
		/>

		<ExecutiveKpiGrid
			fitnessScorePercent={dashboard.fitnessScorePercent}
			passingFitnessRules={dashboard.passingFitnessRules}
			totalFitnessChecks={dashboard.fitnessChecks.length}
			adrsCount={dashboard.counts.adrs}
			domainsCount={dashboard.counts.domains}
			servicesCount={dashboard.counts.services}
			internalServicesCount={dashboard.counts.internalServices}
			systemsCount={dashboard.counts.systems}
			containersCount={dashboard.counts.containers}
			agentsCount={dashboard.counts.agents}
			entitiesCount={dashboard.counts.entities}
			flowsCount={dashboard.counts.flows}
			channelsCount={dashboard.counts.channels}
			totalMessagesCount={dashboard.counts.totalMessages}
			eventsCount={dashboard.counts.events}
			commandsCount={dashboard.counts.commands}
			queriesCount={dashboard.counts.queries}
			totalAutomatedSuites={dashboard.totalAutomatedSuites}
		/>

		<RoleLensSection />

		<VisualAnalyticsSection
			base={base}
			totalMessagesCount={dashboard.counts.totalMessages}
			channelsCount={dashboard.counts.channels}
			messageBreakdown={dashboard.messageBreakdown}
			verificationLayers={dashboard.verificationLayers}
			teamsCount={dashboard.counts.teams}
			usersCount={dashboard.counts.users}
			teamOwnershipStats={dashboard.teamOwnershipStats}
			maxTeamAssets={dashboard.maxTeamAssets}
			domainsCount={dashboard.counts.domains}
			containersCount={dashboard.counts.containers}
			adrsCount={dashboard.counts.adrs}
			firstTeamId={dashboard.firstTeamId}
		/>

		<FitnessScorecardSection
			fitnessChecks={dashboard.fitnessChecks}
			passingFitnessRules={dashboard.passingFitnessRules}
		/>

		<ServiceMatrixSection
			base={base}
			enrichedServices={dashboard.enrichedServices}
			internalServicesCount={dashboard.counts.internalServices}
			maxServiceMessages={dashboard.maxServiceMessages}
		/>

		<PublishedSuitesSection base={base} />
	</div>
</Layout>
