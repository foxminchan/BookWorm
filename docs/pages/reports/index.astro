---
import Layout from "@catalog/layouts/Layout.astro";
import { getServices } from "@catalog/utils";
import ReportsNav from "../_components/ReportsNav.astro";
import { REPORT_SUITES, RESULT_FEEDS } from "../_data/reports";

type CatalogService = {
	data: {
		id: string;
		name: string;
		version: string;
		summary?: string;
	};
};

const services: CatalogService[] = await getServices({ getAllVersions: false });
---

<Layout
	title="Test Reports"
	description="Centralized Allure test reports across BookWorm backend and frontend suites"
	sidebar={false}
>
	<div class="mx-auto max-w-6xl space-y-8">
		<div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
			<div>
				<h1 class="text-3xl font-bold text-[rgb(var(--ec-page-text))]">
					Allure Test Reports
				</h1>
				<p class="mt-1 text-sm text-[rgb(var(--ec-page-text-muted))]">
					Centralized quality dashboard aggregating backend unit/contract tests and frontend
					suites published to GitHub Pages.
				</p>
			</div>
			<a
				href="/reports/index.html"
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-1.5 rounded-lg bg-[rgb(var(--ec-accent))] px-4 py-2 text-sm font-medium text-[rgb(var(--ec-accent-text))] transition-opacity hover:opacity-90"
			>
				Open Unified Report
				<span aria-hidden="true">↗</span>
			</a>
		</div>

		<ReportsNav />

		<div
			id="report-status-banner"
			class="rounded-lg border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-card-bg))] p-4 text-sm text-[rgb(var(--ec-page-text-muted))]"
		>
			Checking hosted Allure report availability...
		</div>

		<section class="space-y-4">
			<h2 class="text-lg font-semibold text-[rgb(var(--ec-page-text))]">
				Published Report Dashboards
			</h2>
			<div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
				{
					REPORT_SUITES.map((suite) => (
						<div class="flex flex-col justify-between rounded-xl border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-card-bg))] p-5">
							<div>
								<div class="flex items-center justify-between gap-2">
									<span class="rounded-full bg-[rgb(var(--ec-accent-subtle))] px-2.5 py-0.5 text-xs font-medium text-[rgb(var(--ec-accent))]">
										{suite.badge}
									</span>
									<span class="text-xs text-[rgb(var(--ec-page-text-muted))]">
										{suite.workflow}
									</span>
								</div>
								<h3 class="mt-3 text-base font-semibold text-[rgb(var(--ec-page-text))]">
									{suite.name}
								</h3>
								<p class="mt-1.5 text-sm text-[rgb(var(--ec-page-text-muted))]">
									{suite.description}
								</p>
							</div>

							<div class="mt-5 flex items-center justify-between border-t border-[rgb(var(--ec-page-border))] pt-3 text-sm">
								<a
									href={`/custom/reports/${suite.id}`}
									class="font-medium text-[rgb(var(--ec-accent))] hover:underline"
								>
									View embedded →
								</a>
								<a
									href={suite.reportUrl}
									target="_blank"
									rel="noopener noreferrer"
									class="text-xs text-[rgb(var(--ec-page-text-muted))] hover:text-[rgb(var(--ec-page-text))]"
								>
									Standalone ↗
								</a>
							</div>
						</div>
					))
				}

				<div class="flex flex-col justify-between rounded-xl border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-card-bg))] p-5">
					<div>
						<div class="flex items-center justify-between gap-2">
							<span class="rounded-full bg-[rgb(var(--ec-accent-subtle))] px-2.5 py-0.5 text-xs font-medium text-[rgb(var(--ec-accent))]">
								BE · TUnit
							</span>
							<span class="text-xs text-[rgb(var(--ec-page-text-muted))]">sonar.yml</span>
						</div>
						<h3 class="mt-3 text-base font-semibold text-[rgb(var(--ec-page-text))]">
							TUnit HTML Reports
						</h3>
						<p class="mt-1.5 text-sm text-[rgb(var(--ec-page-text-muted))]">
							Self-contained per-project TUnit HTML reports for all backend unit, architecture,
							integration, and contract tests.
						</p>
					</div>

					<div class="mt-5 flex items-center justify-between border-t border-[rgb(var(--ec-page-border))] pt-3 text-sm">
						<a
							href="/custom/reports/tunit"
							class="font-medium text-[rgb(var(--ec-accent))] hover:underline"
						>
							Browse reports →
						</a>
						<span class="text-xs text-[rgb(var(--ec-page-text-muted))]">tunit-report-backend</span>
					</div>
				</div>
			</div>
		</section>

		<section class="space-y-4">
			<div>
				<h2 class="text-lg font-semibold text-[rgb(var(--ec-page-text))]">
					Merged CI Result Feeds
				</h2>
				<p class="text-sm text-[rgb(var(--ec-page-text-muted))]">
					Artifacts collected in CI and combined into the Unified Test Report.
				</p>
			</div>
			<div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
				{
					RESULT_FEEDS.map((feed) => (
						<div class="rounded-lg border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-card-bg))] p-4">
							<p class="font-medium text-[rgb(var(--ec-page-text))]">{feed.name}</p>
							<p class="mt-1 text-xs text-[rgb(var(--ec-page-text-muted))]">{feed.scope}</p>
							<div class="mt-3 flex flex-wrap gap-1.5 text-[11px] text-[rgb(var(--ec-page-text-muted))]">
								<code class="rounded bg-[rgb(var(--ec-page-bg))] px-1.5 py-0.5">
									{feed.artifact}
								</code>
								<code class="rounded bg-[rgb(var(--ec-page-bg))] px-1.5 py-0.5">
									{feed.workflow}
								</code>
							</div>
						</div>
					))
				}
			</div>
		</section>

		<section class="space-y-4">
			<div>
				<h2 class="text-lg font-semibold text-[rgb(var(--ec-page-text))]">
					Catalog Services ({services.length})
				</h2>
				<p class="text-sm text-[rgb(var(--ec-page-text-muted))]">
					Jump to documented BookWorm services covered by the backend and frontend test suites.
				</p>
			</div>
			<div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
				{
					services.map((service) => (
						<a
							href={`/docs/services/${service.data.id}/${service.data.version}`}
							class="rounded-lg border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-card-bg))] p-4 transition-colors hover:border-[rgb(var(--ec-accent))]"
						>
							<div class="flex items-center justify-between gap-2">
								<span class="font-medium text-[rgb(var(--ec-page-text))]">
									{service.data.name}
								</span>
								<span class="text-xs text-[rgb(var(--ec-page-text-muted))]">
									v{service.data.version}
								</span>
							</div>
							{service.data.summary && (
								<p class="mt-1 line-clamp-2 text-xs text-[rgb(var(--ec-page-text-muted))]">
									{service.data.summary}
								</p>
							)}
						</a>
					))
				}
			</div>
		</section>
	</div>

	<script>
		const banner = document.getElementById("report-status-banner");
		if (banner) {
			fetch("/reports/index.html")
				.then(async (res) => {
					const html = res.ok ? await res.text() : "";
					if (res.ok && !html.includes("404: Not found")) {
						banner.textContent =
							"Hosted Allure reports are available. Select any suite above to inspect results inline or in a standalone tab.";
					} else {
						banner.textContent =
							"Local preview mode: static Allure HTML reports are generated in CI (docs.yml) and published under /reports/ on GitHub Pages.";
					}
				})
				.catch(() => {
					banner.textContent =
						"Local preview mode: static Allure HTML reports are generated in CI (docs.yml) and published under /reports/ on GitHub Pages.";
				});
		}
	</script>
</Layout>
