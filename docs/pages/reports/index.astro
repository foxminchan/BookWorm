	<script>
		function initDashboardInteractions() {
			const base = import.meta.env.BASE_URL.replace(/\/$/, "");

			// 1. Role Lens Tabs
			const roleButtons = document.querySelectorAll<HTMLButtonElement>("[data-role-tab]");
			const rolePanels = document.querySelectorAll<HTMLElement>("[data-role-panel]");

			roleButtons.forEach((btn) => {
				if (btn.dataset.bound === "true") return;
				btn.dataset.bound = "true";
				btn.addEventListener("click", () => {
					const targetRole = btn.dataset.roleTab;
					roleButtons.forEach((b) => {
						const active = b.dataset.roleTab === targetRole;
						b.setAttribute("aria-selected", active ? "true" : "false");
						b.className = active
							? "role-tab-btn rounded-lg px-3.5 py-1.5 text-xs font-semibold transition-all bg-[rgb(var(--ec-card-bg))] text-[rgb(var(--ec-accent))] shadow-xs"
							: "role-tab-btn rounded-lg px-3.5 py-1.5 text-xs font-semibold transition-all text-[rgb(var(--ec-page-text-muted))] hover:text-[rgb(var(--ec-page-text))]";
					});
					rolePanels.forEach((panel) => {
						panel.classList.toggle("hidden", panel.dataset.rolePanel !== targetRole);
						panel.classList.toggle("block", panel.dataset.rolePanel === targetRole);
					});
				});
			});

			// 2. Service Matrix Filtering
			const filterButtons = document.querySelectorAll<HTMLButtonElement>("[data-matrix-filter]");
			const serviceRows = document.querySelectorAll<HTMLElement>("[data-service-row]");

			filterButtons.forEach((btn) => {
				if (btn.dataset.bound === "true") return;
				btn.dataset.bound = "true";
				btn.addEventListener("click", () => {
					const filter = btn.dataset.matrixFilter;
					filterButtons.forEach((b) => {
						const active = b.dataset.matrixFilter === filter;
						b.className = active
							? "matrix-filter-btn rounded-lg bg-[rgb(var(--ec-card-bg))] px-3 py-1.5 text-xs font-semibold text-[rgb(var(--ec-accent))] shadow-xs"
							: "matrix-filter-btn rounded-lg px-3 py-1.5 text-xs font-semibold text-[rgb(var(--ec-page-text-muted))] hover:text-[rgb(var(--ec-page-text))]";
					});
					serviceRows.forEach((row) => {
						const scope = row.dataset.scope;
						const hasPact = row.dataset.hasPact === "true";
						let visible = true;
						if (filter === "internal") visible = scope === "internal";
						if (filter === "pact") visible = hasPact;
						row.classList.toggle("hidden", !visible);
					});
				});
			});

			// 3. Hosted CI Report Availability Probe
			const banner = document.getElementById("report-status-banner");
			const dot = document.getElementById("report-status-dot");
			const title = document.getElementById("report-status-title");
			const desc = document.getElementById("report-status-desc");
			const tunitBadge = document.getElementById("tunit-count-badge");

			if (!banner || banner.dataset.initialized === "true") return;
			banner.dataset.initialized = "true";

			Promise.allSettled([
				fetch(`${base}/reports/index.html`).then(async (res) => {
					const html = res.ok ? await res.text() : "";
					return res.ok && !html.includes("404: Not found");
				}),
				fetch(`${base}/reports/tunit/manifest.json`).then(async (res) => {
					if (!res.ok) return null;
					const data = await res.json();
					return Array.isArray(data) ? data.length : null;
				}),
			]).then(([allureRes, tunitRes]) => {
				if (!banner.isConnected) return;
				const allureAvailable =
					allureRes.status === "fulfilled" && allureRes.value === true;
				const tunitCount =
					tunitRes.status === "fulfilled" ? tunitRes.value : null;

				if (tunitCount !== null && tunitBadge) {
					tunitBadge.textContent = `${tunitCount} Published TUnit Reports`;
				}

				if (allureAvailable) {
					if (dot) {
						dot.innerHTML = `
							<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-500 opacity-75"></span>
							<span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
						`;
					}
					if (title) {
						title.textContent = "Hosted Allure & TUnit CI Reports Online";
					}
					if (desc) {
						desc.textContent =
							"All CI test artifacts are live. Click any test suite below to inspect full execution logs.";
					}
				} else {
					if (title) {
						title.textContent =
							"Architecture Metrics Active · CI HTML Reports Built in Deployment";
					}
					if (desc) {
						desc.textContent =
							"Catalog metrics and fitness invariants are live. Full Allure & TUnit HTML reports are generated and linked in the docs.yml pipeline.";
					}
				}
			});
		}

		document.addEventListener("astro:page-load", initDashboardInteractions);
		if (document.readyState !== "loading") {
			initDashboardInteractions();
		}
	</script>
</Layout>
