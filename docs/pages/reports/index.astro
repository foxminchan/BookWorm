---
import AllureReportPage from "../_components/AllureReportPage.astro";
import { DEFAULT_REPORT_SUITE_ID, REPORT_SUITES } from "../_data/reports";

const defaultSuite =
	REPORT_SUITES.find((suite) => suite.id === DEFAULT_REPORT_SUITE_ID) ?? REPORT_SUITES[0];
---

<AllureReportPage suite={defaultSuite} isDefault={true} />
