---
import Layout from "@catalog/layouts/Layout.astro";
import ReportsNav from "../_components/ReportsNav.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout
	title="Backend TUnit HTML Reports"
	description="Per-project self-contained TUnit HTML test reports for BookWorm backend services"
	sidebar={false}
	fullWidth={true}
>
	<div class="flex h-[calc(100vh-var(--ec-header-offset,4rem))] flex-col">
		<div
			class="border-b border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-page-bg))] px-6 py-4"
		>
			<div class="mx-auto flex max-w-7xl flex-col gap-3">
				<div class="flex flex-wrap items-center justify-between gap-2">
					<div>
						<h1 class="text-xl font-bold text-[rgb(var(--ec-page-text))]">
							Backend TUnit HTML Reports
						</h1>
						<p class="text-xs text-[rgb(var(--ec-page-text-muted))]">
							Self-contained TUnit reports generated per backend test project in CI.
						</p>
					</div>
					<a
						id="tunit-standalone-link"
						href={`${base}/reports/tunit/manifest.json`}
						target="_blank"
						rel="noopener noreferrer"
						class="hidden items-center gap-1 rounded-lg border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-card-bg))] px-3 py-1.5 text-xs font-medium text-[rgb(var(--ec-page-text))] hover:border-[rgb(var(--ec-accent))]"
					>
						Open standalone ↗
					</a>
				</div>
				<ReportsNav />
			</div>
		</div>

		<div class="flex min-h-0 flex-1 bg-[rgb(var(--ec-page-bg))]">
			<aside
				id="tunit-sidebar"
				class="hidden w-72 shrink-0 overflow-y-auto border-r border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-card-bg))] p-3"
			>
				<p
					class="mb-2 px-2 text-xs font-semibold tracking-wider text-[rgb(var(--ec-page-text-muted))] uppercase"
				>
					Test Projects
				</p>
				<ul id="tunit-project-list" class="space-y-1 text-sm"></ul>
			</aside>

			<div class="relative flex-1">
				<iframe
					id="tunit-frame"
					title="TUnit HTML Report"
					data-base-url={base}
					class="hidden h-full w-full border-0"
				></iframe>

				<div
					id="tunit-loading"
					class="flex h-full flex-col items-center justify-center p-8 text-center text-sm text-[rgb(var(--ec-page-text-muted))]"
				>
					Loading TUnit reports...
				</div>

				<div
					id="tunit-fallback"
					class="hidden h-full flex-col items-center justify-center p-8 text-center"
				>
					<div
						class="max-w-md rounded-xl border border-[rgb(var(--ec-page-border))] bg-[rgb(var(--ec-card-bg))] p-6"
					>
						<h2 class="text-lg font-semibold text-[rgb(var(--ec-page-text))]">
							TUnit reports not generated locally
						</h2>
						<p class="mt-2 text-sm text-[rgb(var(--ec-page-text-muted))]">
							Backend TUnit HTML reports are uploaded as <code class="text-xs"
								>tunit-report-backend</code
							> in CI (<code class="text-xs">sonar.yml</code>) and published to <code
								class="text-xs">/reports/tunit/</code
							> on GitHub Pages.
						</p>
						<a
							href={`${base}/custom/reports`}
							class="mt-4 inline-block rounded-lg bg-[rgb(var(--ec-button-bg))] px-4 py-2 text-sm font-medium text-[rgb(var(--ec-button-text))] transition-colors hover:bg-[rgb(var(--ec-button-bg-hover))]"
						>
							Back to Unified Test Report
						</a>
					</div>
				</div>
			</div>
		</div>
	</div>

	<script>
		import "../_scripts/tunit-reports";
	</script>
</Layout>
