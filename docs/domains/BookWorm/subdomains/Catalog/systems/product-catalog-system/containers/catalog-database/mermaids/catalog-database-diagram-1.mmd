flowchart LR
	catalog["Catalog API\n(.NET 11 REST + gRPC)"]
	ingestion["Catalog Ingestion\n(Azure Functions Worker)"]
	db[("Catalog database\n(PostgreSQL: catalogdb)")]
	blob[("Catalog blob storage\n(Azure Blob: catalog-blob)")]
	qdrant[("Catalog vector\n(Qdrant: vectordb)")]
	kafka["Kafka Broker\n(Wolverine Outbox)"]

	catalog --> |"EF Core: Domain + wolverine"| db
	catalog --> |"HTTPS: Upload/SAS URN"| blob
	catalog --> |"Kafka: CloudEvents"| kafka
	ingestion --> |"Npgsql: Read/Ack pending_vector_updates"| db
	ingestion --> |"gRPC/HTTP: Upsert/Delete vectors"| qdrant

	classDef focal fill:#fdf2ee,stroke:#bf4520,stroke-width:2px,color:#2d3142
	classDef service fill:#ffffff,stroke:#2d3142,stroke-width:1.2px,color:#2d3142
	classDef store fill:#ececec,stroke:#4f5d75,stroke-width:1.2px,color:#2d3142
	classDef input fill:#eef1f6,stroke:#5a6580,stroke-width:1.2px,color:#2d3142
	classDef ext fill:#f5f5f5,stroke:#949eb2,stroke-width:1px,stroke-dasharray:4 3,color:#4f5d75
	class catalog focal
	class db,blob,qdrant,kafka store
	class ingestion input
	linkStyle 0 stroke:#bf4520,stroke-width:2px
	linkStyle 1 stroke:#bf4520,stroke-width:2px
