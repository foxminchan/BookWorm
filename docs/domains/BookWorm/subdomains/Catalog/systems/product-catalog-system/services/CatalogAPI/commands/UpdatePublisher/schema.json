{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "UpdatePublisher",
	"description": "Payload for updating a publisher.",
	"type": "object",
	"additionalProperties": false,
	"required": ["id", "name"],
	"properties": {
		"id": {
			"type": "string",
			"format": "uuid",
			"description": "Identifier of the publisher to update."
		},
		"name": {
			"type": "string",
			"minLength": 1,
			"description": "New display name for the publisher."
		}
	}
}
