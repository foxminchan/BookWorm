architecture-beta
	group aca(logos:microsoft-azure)[Azure Container Apps]
	group data(database)[Azure Managed Data]
	group ai(logos:microsoft-icon)[Microsoft Foundry]
	group ext(internet)[External Services]

	service gateway(logos:dotnet)[YARP Gateway] in aca
	service catalog(logos:dotnet)[Catalog API] in aca
	service ingestion(logos:microsoft-azure)[Catalog Ingestion] in aca

	service pg(logos:postgresql)[PostgreSQL catalogdb] in data
	service redis(logos:redis)[Azure Managed Redis] in data
	service blob(disk)[Catalog Blob Storage] in data

	service foundry(logos:microsoft-azure)[Foundry Project] in ai

	service qdrant(logos:qdrant-icon)[Qdrant Vector DB] in ext
	service kafka(logos:kafka-icon)[Kafka Broker] in ext
	service entra(logos:microsoft-icon)[Microsoft Entra ID] in ext

	gateway:R --> L: catalog
	catalog:T --> B: entra
	catalog:B --> T: pg
	catalog:B --> T: redis
	catalog:B --> T: blob
	catalog:R --> L: foundry
	catalog:R --> L: qdrant
	catalog:R --> L: kafka

	kafka:B --> T: ingestion
	ingestion:L --> R: pg
	ingestion:B --> T: blob
	ingestion:R --> L: foundry
	ingestion:R --> L: qdrant
