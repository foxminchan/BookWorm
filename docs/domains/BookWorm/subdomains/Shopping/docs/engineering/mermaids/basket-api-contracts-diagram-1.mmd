	catalog["Catalog API\n(.NET 11 + gRPC)"]
	ordering["Ordering API\n(.NET 11 + gRPC)"]
	finance["Finance\n(Azure Functions + Durable Task)"]

	gateway --> |"HTTPS: /basket/api/v1/baskets"| basket
