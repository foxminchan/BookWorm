flowchart LR
	gateway["API Gateway\n(YARP Reverse Proxy)"]
	rating["Rating API\n(.NET 11 Minimal API)"]
	cosmos["Azure Cosmos DB\n(ratingdb / feedbacks)"]
	redis["Redis\n(FusionCache + Idempotency)"]
	catalog["Catalog API\n(.NET 11 + catalogdb)"]
	mcp["MCP Tools\n(Read-Only Catalog MCP)"]
	foundry["Microsoft Foundry\n(LLM + Presidio PII)"]

	gateway --> |"HTTPS: /rating/api/v1/feedbacks"| rating
	rating --> |"EF Core Cosmos: /bookId"| cosmos
	rating -->|"Cache + 24h Guard"| redis
	rating --> |"Kafka: rating.feedback-create / delete"| catalog
	catalog --> |"Kafka: catalog.book-update-rating-failed"| rating
	rating --> |"MCP: get_book"| mcp
	rating --> |"Agent Framework: rating-agent"| foundry

	classDef focal fill:#fdf2ee,stroke:#bf4520,stroke-width:2px,color:#2d3142
	classDef service fill:#ffffff,stroke:#2d3142,stroke-width:1.2px,color:#2d3142
	classDef store fill:#ececec,stroke:#4f5d75,stroke-width:1.2px,color:#2d3142
	classDef input fill:#eef1f6,stroke:#5a6580,stroke-width:1.2px,color:#2d3142
	classDef ext fill:#f5f5f5,stroke:#949eb2,stroke-width:1px,stroke-dasharray:4 3,color:#4f5d75
	class rating focal
	class catalog,mcp service
	class cosmos,redis store
	class gateway input
	class foundry ext
	linkStyle 0 stroke:#bf4520,stroke-width:2px
	linkStyle 1 stroke:#bf4520,stroke-width:2px
