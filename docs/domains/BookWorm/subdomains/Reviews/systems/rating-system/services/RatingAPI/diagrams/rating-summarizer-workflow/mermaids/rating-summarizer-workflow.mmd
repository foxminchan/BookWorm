%%{init: {'theme': 'base', 'themeVariables': {'background': '#f5f5f5', 'primaryColor': '#ffffff', 'primaryTextColor': '#2d3142', 'primaryBorderColor': '#2d3142', 'secondaryColor': '#ececec', 'secondaryBorderColor': '#4f5d75', 'tertiaryColor': '#fdf2ee', 'tertiaryBorderColor': '#bf4520', 'lineColor': '#4f5d75', 'textColor': '#2d3142', 'clusterBkg': '#f8f9fa', 'clusterBorder': '#bfc0c0', 'fontFamily': 'Geist, system-ui, sans-serif'}}}%%
flowchart TD
	Partition["Partition Reviews into Batches"]
	Worker0["Summarize Batch Worker 1"]
	Worker1["Summarize Batch Worker 2"]
	Worker2["Summarize Batch Worker 3"]
	Worker3["Summarize Batch Worker 4"]
	FanIn(("Fan-In"))
	Join["Join & Order Partial Summaries"]
	Reduce["Consolidate Summary"]
	Assess["Assess Quality & Confidence"]
	Refine["Build Refinement Feedback"]
	Classify["Classify Rating (Deterministic Rules)"]

	Partition --> Worker0
	Partition --> Worker1
	Partition --> Worker2
	Partition --> Worker3
	Worker0 --> FanIn
	Worker1 --> FanIn
	Worker2 --> FanIn
	Worker3 --> FanIn
	FanIn --> Join
	Join --> Reduce
	Reduce --> Assess
	Assess -->|"Confidence below threshold and pass below cap"| Refine
	Assess -->|"Confidence met or refinement cap reached"| Classify
	Refine -->|"Partial summaries + feedback (next pass)"| Reduce

	classDef focal fill:#fdf2ee,stroke:#bf4520,stroke-width:2px,color:#2d3142
	classDef service fill:#ffffff,stroke:#2d3142,stroke-width:1.2px,color:#2d3142
	classDef input fill:#eef1f6,stroke:#5a6580,stroke-width:1.2px,color:#2d3142
	class FanIn focal
	class Worker0,Worker1,Worker2,Worker3,Join,Reduce,Assess,Refine,Classify service
	class Partition input
	linkStyle 4 stroke:#bf4520,stroke-width:2px
	linkStyle 5 stroke:#bf4520,stroke-width:2px
