	recRes["book-recommendation-researcher\n(Sub-Agent, temp 0.4)"]
	mcp["MCP Tools\n(mcptools /mcp)"]
	catalog["Catalog API\n(.NET 11 gRPC)"]
	memory["Memory Providers\n(Foundry + FileMemory)"]
