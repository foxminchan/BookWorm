stateDiagram-v2

state "Ordering API (Authoritative Status)" as OrderingStatus {
	[*] --> New: POST /api/v1/orders
	New --> Completed: PATCH .../complete
	New --> Cancelled: PATCH .../cancel
	Completed --> [*]
	Cancelled --> [*]
	note right of New
	DeleteBasketFailedCommand sets IsDeleted = true
	(soft delete only; Status remains New)
	end note
}

state "Finance Orchestration (finance-taskhub)" as FinanceState {
	[*] --> Placed: UserCheckedOutIntegrationEvent
	Placed --> BasketDeletionFailed: BasketDeletedFailedIntegrationEvent
	Placed --> FinanceCompleted: OrderStatusChangedToComplete
	Placed --> FinanceCancelled: OrderStatusChangedToCancel
	Placed --> FinanceCancelled: Retry timeout (3x 30m)
	BasketDeletionFailed --> [*]
	FinanceCompleted --> [*]
	FinanceCancelled --> [*]
}
