{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "BuyerDtoArray",
	"description": "Buyer list response documented by the Ordering API OpenAPI contract.",
	"type": "array",
	"items": {
		"type": "object",
		"required": ["id", "name", "address"],
		"properties": {
			"id": {
				"type": "string",
				"format": "uuid"
			},
			"name": {
				"type": ["string", "null"]
			},
			"address": {
				"type": ["string", "null"]
			}
		}
	}
}
