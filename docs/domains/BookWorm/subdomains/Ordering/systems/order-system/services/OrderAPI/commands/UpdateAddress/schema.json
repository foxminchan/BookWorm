{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "UpdateAddressCommand",
	"description": "Address fields required to update the authenticated Buyer's address.",
	"type": "object",
	"required": ["street", "city", "province"],
	"properties": {
		"street": {
			"type": "string"
		},
		"city": {
			"type": "string"
		},
		"province": {
			"type": "string"
		}
	}
}
