architecture-beta
	group aca(logos:microsoft-azure)[Azure Container Apps]
	group data(database)[Azure Managed Data]
	group ext(internet)[External Services]

	service gateway(logos:dotnet)[YARP Gateway] in aca
	service ordering(logos:dotnet)[Ordering API] in aca
	service finance(logos:microsoft-azure)[Finance Functions] in aca
	service catalog(logos:dotnet)[Catalog API] in aca
	service basket(logos:dotnet)[Basket API] in aca

	service pg(logos:postgresql)[PostgreSQL orderingdb] in data
	service redis(logos:redis)[Azure Managed Redis] in data
	service dts(logos:microsoft-azure)[Durable Task Scheduler] in data
	service storage(disk)[Functions Host Storage] in data

	service kafka(logos:kafka-icon)[Kafka Broker] in ext
	service entra(logos:microsoft-icon)[Microsoft Entra ID] in ext

	gateway:R --> L: ordering
	ordering:T --> B: entra
	ordering:B --> T: catalog
	ordering:B --> T: basket
	ordering:R --> L: pg
	ordering:R --> L: redis
	ordering:R < --> L: kafka

	kafka:B < --> T: finance
	finance:L --> R: dts
	finance:B --> T: storage
